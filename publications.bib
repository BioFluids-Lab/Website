@article{porenta_assessment_1999,
	title = {Assessment of coronary stenoses by {Doppler} wires: a validation study using in vitro modeling and computer simulations},
	volume = {25},
	issn = {03015629 (ISSN)},
	url = {https://doi.org/10.1016/S0301-5629(99)00033-2},
	doi = {10.1016/S0301-5629(99)00033-2},
	abstract = {The present study evaluates the use of intracoronary velocity measurements by Doppler guidewires for assessing coronary obstructions. In vitro experiments were performed in a flow model using acrylic phantoms of coronary stenoses with different configurations (stenosis area: 56\%, 75\% and 89\%; stenosis length: 1 and 5 mm; stenosis border: tapering or abrupt). Nonpulsatile laminar flow conditions of a test fluid were established at flow rates ranging from 0.5 to 2.0 mL/s to simulate baseline flow and flow after vasodilation. Peak Doppler velocity was measured proximal to, within and distal to the model stenoses. Computer simulations were employed to calculate radial flow profiles with and without a Doppler wire aligned with the vessel center. In 84 in vitro flow experiments, peak Doppler velocity correlated well with the average flow velocity as calculated from the actual flow rate and the vessel's cross-sectional area proximal to (r = 0.98, SEE = 1.4, p {\textless} 0.001) and within (r = 0.97, SEE = 16.4, p {\textless} 0.001) the stenosis. However, the ratio of calculated average velocity to Doppler-measured peak velocity was significantly different from 0.5, the expected value for a parabolic flow profile (0.76 ± 0.08, 0.81 ± 0.14; p {\textless} 0.001). Acceptable accuracy was found for the Doppler estimation of stenosis severity using the continuity equation (error: 0.9 ± 1.2\% and -4.6 ± 3.5\% for stenosis with a length of 5 mm and 1 mm, respectively). Doppler velocity reserve significantly underestimated the true flow reserve for the 56\% and 75\% stenoses (p {\textless} 0.01). Computer simulations demonstrated significant alterations of flow profiles by the wire, which explained the observed underestimation of the true flow reserve by the Doppler velocity reserve. Thus, Doppler guidewire measurements of intracoronary flow velocities are useful to assess the severity of coronary stenoses. However, the in vitro results and computer simulations indicate that guidewires alter the flow profile, so that Doppler velocity reserve may underestimate the true flow reserve.},
	language = {English},
	number = {5},
	journal = {Ultrasound in Medicine and Biology},
	publisher = {Elsevier Science Ltd},
	author = {Porenta, G. and Schima, H. and Pentaris, A. and Tsangaris, S. and Moertl, D. and Probst, P. and Maurer, G. and Baumgartner, H.},
	year = {1999},
	keywords = {article, blood flow velocity, Blood vessels, computer simulation, Computer simulation, coronary artery blood flow, Coronary artery disease, coronary artery obstruction, Coronary flow, disease severity, Diseases, Doppler effect, Doppler flowmetry, Doppler ultrasound, Doppler wires, Errors, flow rate, guide wire, Hemodynamics, laminar flow, Laminar flow, priority journal, Ultrasonic velocity measurement},
	pages = {793--801},
	annote = {Export Date: 29 August 2026; Cited By: 21; Correspondence Address: G. Porenta; Department of Cardiology, University of Vienna, A 1090 Vienna, Wahringer Gurtel 18-20, Austria; email: gporenta@pop3.kard.akh-wien.ac.at; CODEN: USMBA},
}

@article{drikakis_solution_1993,
