	author = {Georgakarakos, Efstratios and Raptis, Anastasios and Schoretsanitis, Nikolaos and Bisdas, Theodosios and Beropoulis, Efthymios and Georgiadis, George and Matsagkas, Miltiadis and Xenos, Michalis},
