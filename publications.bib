	author = {Drikakis, D. and Tsangaris, S.},
	year = {1993},
	keywords = {Boundary layers, Compressible flow, Convergence of numerical methods, Diffusion, Discretization, Flow interactions, Flux Vector Splitting, Flux vector splitting method, flux vector splitting methods, Gas dynamics, Gauss-Seidel relaxation technique, mathematical model, Mathematical models, Mathematical Techniques, Monotone upstream centered scheme for conservation law, Navier-Stokes equations, Navier-Stokes Equations, Numerical methods, Shock waves, Unsteady flow, upwind schemes, Upwind schemes, Vectors, viscous compressible flows, Viscous flow},
	pages = {282--297},
