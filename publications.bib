	keywords = {3D geometry, Arteriovenous shunt, Bioinformatics, Biplane angiographies, Carotid artery, Color Doppler, Commercial codes, Common carotid artery, Computational fluid dynamics, Computational model, Dean vortex, Flow fields, Histological examination, Hydrodynamics, In-vivo, Input data, Internal jugular veins, Intimal hyperplasia, Intravascular, Jugular veins, Local flow field, Numerical computations, Three dimensional, Ultrasound measurement, Vessel walls, Wall shear stress},
	annote = {Export Date: 29 August 2026; Cited By: 1; Correspondence Address: T. A. Manos; Laboratory of Biofluid-Mechanics and Biomedical Engineering, National Technical University of Athens, Athens, Greece; email: tmanos@fluid.mech.ntua.gr; Conference name: 8th IEEE International Conference on BioInformatics and BioEngineering, BIBE 2008; Conference date: 8 October 2008 through 10 October 2008; Conference code: 77628},
