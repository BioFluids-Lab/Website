	annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: D. Mathioulakis; Engineering School, Bahrain Polytechnic, Isa Town, P.O. Box 33349, Bahrain; email: dimitrios.mathioulakis@polytechnic.bh},
