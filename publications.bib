@article{koullias_left_1995,
	title = {Left main coronary artery disease vs. left main equivalent disease: a computer-assisted hemodynamic comparison},
	volume = {36},
	issn = {10117970 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0029549723&partnerID=40&md5=6d9f204f49ad7863dc8e3034c31c7c24},
	abstract = {Introduction: Left main coronary artery disease (LM) i.e. the presence of luminal diameter stenosis equal to or greater than 50 per cent in the left main coronary artery, and left main equivalent disease (LMEQ) i.e. the presence of luminal stenoses equal to or greater than 70 per cent in both the proximal left anterior descending coronary artery (LAD) and the proximal left circumflex coronary artery (LCX), are two disease entities which, because of their unfavorable prognosis, are managed surgically. In the present study, by means of computer software developed by our group, we calculated left epicardial blood flow and pressure curves and we attempted to compare hemodynamically the aforementioned entities, in order to correlate the derived results with clinical data revealing that both conditions are characterized by an unfavorable clinical course, with LMEQ somewhat less grave thun LM. Methods: For the fluid-dynamic study of left epicardial circulation, a mathematical and a geometrical model were needed. The mathematical model was based on the one-dimension Navier-Stokes equations. The main variables of the model are blood velocity, intracoronary blood pressure, blood viscosity and cross-sectional area of the artery along the system. At the inlet of the system (left coronary ostium), the aortic pressure is imposed. At the distal beds, peripheral resistance directly and linearly dependent on the left ventricular pressure, is imposed. The geometrical model was based on physiological and autopsy data regarding length, lumen diameter and elastic properties of a right coronary artery (RCA)-dominant left epicardial coronary circulation system. The location and severity of obstruction caused by the imposed stenoses were selected in such a way that the resulting model would simulate LM and LMEQ conditions. Thus, for LM, a 1.2 cm-long stenosis causing 80 per cent narrowing of the left main coronary artery was introduced; for LMEQ, two stenoses, each 1.5 cm-long and causing 80 per cent obstruction, were introduced at the origin of the LAD und LCX, respectively. Results: The interposition of a stenosis causes major pressure and flow drops. Blood flow is predominantly altered during diastole. Thus, poststenotically, coronary blood flow, rather than being 70 per cent diastolic as is the case in the intact coronary vascular bed, becomes systolic. This feature probably represents a compensatory mechanism in patients with severe perfusion deficits. Both LM and LMEQ reduce overall left myocardial blood supply by approximately 50 per cent. In the latter case, however, blood supply to the left coronary circulation is 7.2 per cent greater than in the former (55 per cent vs. 47.8 per cent). Under normal conditions, the LAD receives 55.7 per cent of the total amount of blood entering the left main coronary artery. In LM, this percentage drops to 53.1, while in LMEQ it is reduced to 46.6. The blood flow waveform changes from its original contour to a waveform that consists of a systolic bell-shaped part, corresponding to the time interval between the onset of ventricular ejection and the aortic valve closure, and a diastolic part which is a flow plateau that lasts from the onset of rapid ventricular filling to the end of the atrial contraction. Intracoronary blood pressure along the LAD is, in every instance, higher in LMEQ than in LM: This difference is greater during systole. Compared with its normal values, blood flow to the LCX is reduced to 50 per cent in LM and to 54.6 per cent in LMEQ. Along the consecutive segments of the LCX, the blood flow waveform changes drastically after the interposition of the stenosis. As is the case in the LAD, systolic and diastolic blood flow in the LCX is higher in the LMEQ model than in the LM model. Conclusions: Reduction of blood supply to the left ventricle by 50 per cent in both LM and LMEQ justifies the name of the latter and provides an explanation for the unfavorable natural history of both disorders. In the present study, we demonstrated that the reduced blood supply is unevenly distributed between the LAD and the LCX.},
	language = {Greek},
	number = {5},
	journal = {Hellenic Journal of Cardiology},
	author = {Koullias, G.J. and Rammos, K.S. and Pappou, T.J. and Tsangaris, S.G. and Panagopoulos, P.G.},
	year = {1995},
	keywords = {article, computer assisted diagnosis, coronary artery disease, flow, hemodynamics, human, left coronary artery, left main coronary artery disease, left main equivalent disease, mathematical analysis, pressure, prognosis},
	pages = {518--527},
	annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: HLKEA},
}

@article{makris_particle_2014,
	title = {Particle transport and deposition under high-frequency oscillatory ventilation and normal breathing},
	volume = {48},
	issn = {15217388 (ISSN)},
	url = {https://doi.org/10.1080/02786826.2013.865831},
	doi = {10.1080/02786826.2013.865831},
	abstract = {The fluid mechanics of high-frequency oscillatory ventilation (HFOV) for gas transport in the pulmonary region of the human lungs have been thoroughly studied by different methods. The major concept of HFOV adaptation is to push gas into further generation of the bronchial tree, with adequate gas mixing and small tidal volume. However, particle transport and deposition under HFOV is a rarely studied case where different mechanisms, compared to the mechanisms of gas transport, may associate. The target of this study is to numerically compare the efficiency of particle drug deposition under HFOV to normal breathing (NB) and to further clarify the mechanisms of particle transport and deposition under oscillating flows. A fully Eulerian computational fluid particles dynamic (CFPD) model is used for studying the transport and deposition of several sizes of inertia particles, under different transient flow conditions, inside a single physiologically realistic bifurcation created by generations G3-G4 of the human lung. An insight into the particle dynamics under high-frequency oscillating flow fields is given and the results showed that the highly oscillating field (HFOV) displayed stronger secondary flows, thinner boundary layers, and strong counter flow that accumulate and deposit particles further than a lower frequency oscillatory field (NB). Copyright © American Association for Aerosol Research.},
	language = {English},
	number = {2},
	journal = {Aerosol Science and Technology},
	author = {Makris, E. and Pilou, M. and Neofytou, P. and Tsangaris, S. and Housiadas, C.},
	year = {2014},
	keywords = {adaptation, aerosol, airway dynamics, article, artificial ventilation, boundary layer, breathing, Computational fluid, computational fluid dynamics, Deposition, Different mechanisms, exhalation, flow rate, Fluid mechanics, gas mixing, gas transport, High frequency HF, high frequency oscillation, high frequency oscillatory ventilation, high frequency ventilation, human, imaging software, inhalation, Oscillating fields, Oscillating flow, Particle dynamics, Particle separators, particle size, Particle transport and depositions, Physiological models, pressure gradient, priority journal, Realistic bifurcation, Respiratory system, simulation, tidal volume, tracheobronchial tree, Transient flow conditions},
	pages = {150--162},
	annote = {Export Date: 29 August 2026; Cited By: 7; Correspondence Address: E. Makris; Thermal Hydraulics and Multiphase Flow Laboratory, Institute of Nuclear and Radiological Sciences and Technology Energy and Safety, National Centre for Scientific Research Demokritos, Agia Paraskevi, Athens, Greece; email: vagmakr@ipta.demokritos.gr; CODEN: ASTYD},
