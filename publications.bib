@article{moulinos_computational_2022,
	title = {Computational analysis of active and passive flow control for backward facing step},
	volume = {10},
	issn = {20793197 (ISSN)},
	url = {https://doi.org/10.3390/computation10010012},
	doi = {10.3390/computation10010012},
	abstract = {The internal steady and unsteady flows with a frequency and amplitude are examined through a backward facing step (expansion ratio 2), for low Reynolds numbers (Re = 400, Re = 800), using the immersed boundary method. A lower part of the backward facing step is oscillating with the same frequency as the unsteady flow. The effect of the frequency, the amplitude, and the length of this oscillation is investigated. By suitable active control regulation, the recirculation lengths are reduced, and, for a percentage of the time period, no upper wall, negative velocity, region occurs. Moreover, substituting the prescriptively moving surface by a pressure responsive homogeneous membrane, the fluid–structure interaction is examined. We show that, by selecting proper values for the membrane parameters, such as membrane tension and applied external pressure, the upper wall flow separation bubble vanishes, while the lower one diminishes significantly in both the steady and the unsteady cases. Furthermore, for the time varying case, the length fluctuation of the lower wall reversed flow region is fairly contracted. The findings of the study have applications at the control of confined and external flows where separation occurs. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
	language = {English},
	number = {1},
	journal = {Computation},
	publisher = {MDPI},
	author = {Moulinos, I. and Manopoulos, C. and Tsangaris, S.},
	year = {2022},
	keywords = {Active and passive flow control, Backward facing step, Curvilinear immersed boundary method, Elastic membrane, Flow separation, Fluid–structure interaction, Oscillating surface, Unsteady flow},
	annote = {Export Date: 29 August 2026; Cited By: 5; Correspondence Address: C. Manopoulos; Laboratory of Biofluid Mechanics \& Biomedical Engineering, School of Mechanical Engineering, National Technical University of Athens, Athens, Zografos, 15780, Greece; email: manopoul@central.ntua.gr},
	annote = {Export Date: 29 August 2026; Cited By: 5; Correspondence Address: C. Manopoulos; Laboratory of Biofluid Mechanics \& Biomedical Engineering, School of Mechanical Engineering, National Technical University of Athens, Athens, Zografos, 15780, Greece; email: manopoul@central.ntua.gr},
