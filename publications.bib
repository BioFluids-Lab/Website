@article{gkiolas_experimental_2020,
	title = {Experimental study of the near wake of a circular cylinder and its detached shear layers},
	volume = {113},
	issn = {08941777 (ISSN)},
	url = {https://doi.org/10.1016/j.expthermflusci.2020.110040},
	doi = {10.1016/j.expthermflusci.2020.110040},
	abstract = {The near wake of a cylinder (x {\textless} 1.6D) and its detached shear layers are studied at Re = 3.5 × 104 through phase averaging of 2D-PIV snapshots using as trigger the pressure at φ=90°. The shedding cycle is examined at 8 time instants as well as at 16 time instants based on POD analysis. In the shear layer region, the flow becomes fully turbulent at x {\textasciitilde} 0.45D according to the momentum thickness spatial variation, whereas based on the velocity profile shapes there is a transition from convective to absolute type of instabilities at the same x - station. The Karman vortices once formed at (0.8D, ±0.5D),accelerate streamwise towards the wake centre line following curved trajectories with speeds much smaller than those at the distant field. The Reynolds stresses and the turbulent kinetic energy production of each phase exhibit peaks downstream of the vortex centres in contrast to the spanwise vorticity, swirling strength and turbulent kinetic energy which maximize at the vortex centres, seen from a moving frame of reference. In the wake, normally v'2¯ {\textgreater} u'2¯ in contrast to the shear layer region in which u'2¯ {\textgreater} v'2¯. The Reynolds shear u'v'¯ being the smallest of the Reynolds stresses in the wake, shows two peaks of opposite sign, one being close to the vortex. The pressure at φ=90° (which might be related to the lift applied on the cylinder) takes its peak values with a time delay after the Karman vortex formation and particularly when the latter passes through x {\textasciitilde} 1.05D, its fluctuations being high or low according to the size of the vortex. © 2020 Elsevier Inc.},
	language = {English},
	journal = {Experimental Thermal and Fluid Science},
	publisher = {Elsevier Inc.},
	author = {Gkiolas, D. and Kapiris, P. and Mathioulakis, D.},
	year = {2020},
	keywords = {Circular cylinders, Convection velocity, Detached shear layer, Karman vortices, Kinetic energy, Kinetics, Momentum thickness, Reynolds number, Shear flow, Spatial variations, Swirling strength, Turbulent kinetic energy, Velocity profiles, Vortex flow, Vorticity, Wakes},
	annote = {Export Date: 29 August 2026; Cited By: 5; Correspondence Address: D. Mathioulakis; Fluids Section, School of Mechanical Engineering, National Technical University of Athens, Zografos, 9 Heroon Polytechniou St., 15773, Greece; email: mathew@fluid.mech.ntua.gr; CODEN: ETFSE},
}

@article{koutsiaris_microscope_1999,
	title = {Microscope {PIV} for velocity-field measurement of particle suspensions flowing inside glass capillaries},
	volume = {10},
	issn = {09570233 (ISSN)},
	url = {https://doi.org/10.1088/0957-0233/10/11/311},
