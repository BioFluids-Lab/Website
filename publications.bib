	year = {2021},
	keywords = {Curvilinear immersed boundary method, Flow control, Non-Newtonian fluids, Peristalsis, Pumping characteristic, Roller pumps, Shear-thinning fluids},
	annote = {Export Date: 29 August 2026; Cited By: 2; Correspondence Address: C. Manopoulos; Laboratory of Biofluid Mechanics \& Biomedical Engineering, School of Mechanical Engineering, National Technical University of Athens, Athens, 15780, Greece; email: manopoul@central.ntua.gr},
