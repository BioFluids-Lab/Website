	year = {2007},
	keywords = {Approximation theory, Block mesh refinement, Cartesian grid refinement, Computational geometry, Convergence of numerical methods, Curvilinear geometry approximation, Flow fields, Incompressible flow, Laminar flow, Mesh generation, Navier Stokes equations, Navier-Stokes},
