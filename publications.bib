@article{katsoudas_linking_2026,
	title = {Linking aneurysmal geometry and hemodynamics using computational fluid dynamics},
	volume = {38},
	issn = {10706631 (ISSN)},
	url = {https://doi.org/10.1063/5.0315857},
	doi = {10.1063/5.0315857},
	abstract = {The development of Abdominal Aortic Aneurysms (AAA) is related to complex flow patterns and wall-shear–driven mechanobiological stimuli, yet the quantitative relationship between aneurysmal geometry and hemodynamics remains poorly defined. In this study, we conduct a comprehensive hemodynamic analysis of 74 patient-specific abdominal aortas. A multiscale framework coupling zero-dimensional to one-dimensional (0D–1D) systemic circulation models with three-dimensional (3D) stabilized finite-element simulations is used to generate physiologically consistent boundary conditions and high-fidelity flow fields. From each model, we extract the Time Averaged Wall Shear Stress (TAWSS), Oscillatory Shear Index, Relative Residence Time (RRT), and Local Normalized Helicity indicators alongside an extended set of geometric descriptors characterizing diameter, curvature, and torsion. Our results reveal distinct and statistically significant geometry–hemodynamics relationships across the cohort, separately for the aneurysmal sac and the iliac regions. Large aneurysmal sacs exhibit elevated RRT values, enlarged recirculating zones, and reduced TAWSS. Surprisingly, the iliac arteries emerge as dominant contributors to disturbed hemodynamics, showing stronger geometric–hemodynamic correlations than the infrarenal aorta. These observations highlight previously underappreciated downstream effects of AAA morphology. This study provides a comprehensive view of how aneurysm shape influences blood-flow behavior, supported by one of the largest systematically analyzed Computational Fluid Dynamics datasets of AAAs to date. Our results show that specific geometric features reliably shape shear-stress patterns, suggesting that these geometry-driven flow signatures could serve as valuable biomarkers for patient-specific risk assessment. Together, these insights highlight the potential of incorporating detailed geometric descriptors into future models that aim to predict AAA growth and rupture. © 2026 Author(s).},
	language = {English},
	number = {3},
	journal = {Physics of Fluids},
	publisher = {American Institute of Physics},
	author = {Katsoudas, S.C. and Kyriakoudi, K.C. and Chrimatopoulos, G.T. and Linardopoulos, P.D. and Chrimatopoulos, C.T. and Raptis, A.A. and Moulakakis, K.G. and Kakisis, J.D. and Manopoulos, C.G. and Xenos, M.A. and Tzirtzilakis, E.E.},
	year = {2026},
	keywords = {Abdominal aortic aneurysms, Blood vessels, Computational fluid, Computational fluid dynamics, Computational geometry, Fluid-dynamics, Geometric descriptor, Haemodynamics, Hemodynamics, Morphology, One dimensional, Patient specific, Physiological models, Residence time, Risk assessment, Shear flow, Shear stress, Shearing, Time-averaged, Wall shear stress, Wall-shear stress},
	annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: E.E. Tzirtzilakis; Department of Civil Engineering, University of Peloponnese, Patras, Greece; email: etzirtzilakis@go.uop.gr; CODEN: PHFLE},
}

@article{rogkas_nondimensional_2020,
	title = {Nondimensional characterization of the operational envelope of a wet friction clutch},
	volume = {8},
	issn = {20793197 (ISSN)},
	url = {https://doi.org/10.3390/COMPUTATION8010021},
	doi = {10.3390/COMPUTATION8010021},
	abstract = {In recent years, multidisc wet friction clutches are used in demanding powertrains of automatic and dual clutch transmissions targeting high efficiency and smoothness during gearshift. However, the developed flow pattern between the clutch discs is significantly complex and the Computational Fluid Dynamics (CFD) methods employed are quite demanding in terms of computational cost. To deal with this issue semi-analytical solutions were derived, which are limited, however, to specific problems, in order to obtain handy expressions, while also providing insight to the wet clutch physics. Nevertheless, this lack of global validity is counterbalanced by the fact that the governing equations become analytically solvable at specific operational conditions with satisfactory accuracy, provided that the simplifications rendering the truncated terms inactive hold true. In this work, a quantitative way of determining the relative weight of each term of the Navier-Stokes (NS) equations set is presented, based on the post-processing of CFD results using the Buckingham "π-theorem". The sets of nondimensional numbers created were used to describe and model the physics of the wet clutch. © 2020 by the authors.},
	language = {English},
	number = {1},
	journal = {Computation},
	publisher = {MDPI Multidisciplinary Digital Publishing Institute},
	author = {Rogkas, N. and Vakouftsis, C. and Vasileiou, G. and Manopoulos, C. and Spitas, V.},
	year = {2020},
	keywords = {Nondimensionalization, Squeeze flow, Torsional couette flow, Truncated forms of NS equations, Wet clutch, Π-theorem},
	annote = {Export Date: 29 August 2026; Cited By: 7; Correspondence Address: N. Rogkas; Laboratory of Machine Design, National Technical University of Athens, Zografou, Athens, 9 Iroon Polytechniou, 157 80, Greece; email: nrogkas@mail.ntua.gr},
}

@article{mathioulakis_ground_2025,
	title = {Ground clearance effects on the aerodynamic loading of tilted flat plates in tandem},
	volume = {10},
	issn = {23115521 (ISSN)},
	url = {https://doi.org/10.3390/fluids10060155},
	doi = {10.3390/fluids10060155},
	abstract = {The aerodynamic loading of four as well as of six tilted flat plates-panels arranged in tandem and in close proximity to the ground is examined through force and pressure measurements. In the four-plate set up, conducted in an open-circuit wind tunnel, a movable floor is used to vary the ground clearance, and a one-component force balance is employed to measure the drag coefficient Cd of each plate for tilt angles 10° to 90° and for two head-on wind directions, 0° and 180°. An increase in the ground clearance from 20\% to 60\% of the plates’ chord length, results in a Cd increase of over 40\% in the downstream plates, and up to 20\% in the leading one. For tilt angles below 40°, the drag on the first plate is up to 25\% higher under the 180° wind direction compared to the opposite direction. Pressure distributions are also presented on a series of six much larger plates, examined in a closed-circuit wind tunnel at tilt angles ±30°. While the windward surfaces exhibit relatively uniform pressure distributions, regions of low pressure develop on their suction side, near the plates’ tips leading edge, tending to become uniform streamwise. © 2025 by the authors.},
	language = {English},
	number = {6},
	journal = {Fluids},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	author = {Mathioulakis, D. and Vasilikos, N. and Kapiris, P. and Georgantopoulou, C.},
	year = {2025},
	keywords = {drag, ground clearance, high angle of attack, plate pressure distribution, tandem configuration, tilted plate},
	annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: D. Mathioulakis; Mechanical Department, School of Engineering, Bahrain Polytechnic, Isa Town, P.O. Box 33349, Bahrain; email: dimitrios.mathioulakis@polytechnic.bh},
}

@inproceedings{gkiolas_piv_2020,
	title = {{PIV} and surface pressure measurements on a {NACA64418} airfoil undergoing stall flutter},
	isbn = {978-162410595-1 (ISBN)},
	url = {https://doi.org/10.2514/6.2020-0090},
	doi = {10.2514/6.2020-0090},
	abstract = {The present work examines the aerodynamic behavior of a rectangular wing (NACA64-418) in a subsonic wind tunnel with a chord c = 500 mm and a span of 1390 mm during self-sustained pitching and plunging oscillations. The wing elastic axis was located 35\% of the chord length far from the leading edge and its centre of gravity at 46\%. At a free speed U∞ = 14.9 m/s (Re = 5.3x105) and after initially displacing the wing from its equilibrium position along the plunging axis, the wing started oscillating with a frequency of 3.3 Hz (reduced frequency k=ωc/2U∞= 0.35), a mean effective angle of 15.5° and amplitude 12.5°. Based on phase-locked 2D-PIV and pressure measurements at the midspan plane, the evolution of the flow field was recorded. During upstroke the flow was attached at the leading-edge area and the lift took values higher than the corresponding static values beyond the static stall angle. At the same time a recirculation zone started to develop at the trailing edge which expanded upstream with increasing angle. During downstroke, a shear layer was formed in the suction side of the leading edge which was detached from the wing surface with a relatively high angle. In the rest region of the suction side, the flow was moving upstream with velocities which approached U∞ differing from the characteristics of stagnant flow. As a result, the lift coefficient was relatively high despite the high drag coefficient values. The angle being reduced caused the shear layer at the leading edge to approach the wing surface and the flow to tend to reattach. © 2020 American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
	language = {English},
	booktitle = {{AIAA} {Scitech} {Forum}},
	publisher = {American Institute of Aeronautics and Astronautics Inc, AIAA},
	author = {Gkiolas, D. and Mathioulakis, D.},
	year = {2020},
	note = {Journal Abbreviation: AIAA Scitech Forum},
	keywords = {Centre of gravity, Coefficient values, Equilibrium positions, Flight dynamics, Flow of fluids, Pressure measurement, Recirculation zones, Rectangular wings, Reduced frequency, Shear flow, Subsonic wind tunnels, Surface pressure measurements, Wind tunnels, Wings},
	pages = {1--11},
	annote = {Export Date: 29 August 2026; Cited By: 4; Conference name: AIAA Scitech Forum, 2020; Conference date: 6 January 2020 through 10 January 2020; Conference code: 237189},
}

@article{mathioulakis_pulsating_1989,
