@article{stamatopoulos_study_2008,
	title = {Study of an integrated thermal sensor in different operational modes, under laminar, transitional and turbulent flow regimes},
	volume = {32},
	issn = {08941777 (ISSN)},
	url = {https://doi.org/10.1016/j.expthermflusci.2008.06.003},
	doi = {10.1016/j.expthermflusci.2008.06.003},
	abstract = {The behaviour of a thermal flow sensor attached to the wall of a square tube is examined, exposed to gas flow for Reynolds numbers in the range 0-4.1 × 104. Consisting of a polysilicon heater and a pair of thermopiles, the sensor's three output signals (heater power, its electric resistance and the thermopile signal) are analyzed as a function of Re. Employing three different modes of operation (constant power (CP), constant voltage (CV) and constant temperature (CT)), it was found that the sensor sensitivity maximizes in CT mode. Heater power and its resistance vary with Rea where a changes significantly for Re {\textgreater} 2000. The thermopile signal, which corresponds to the streamwise temperature gradient across the heater, in contrast to the other two signals, is more sensitive in detecting flow disturbances. Its fluctuations increase with a high rate close to Re = 1800, a value which is smaller than the corresponding increase of the other two signals. The probability density function (pdf) of its fluctuations is negatively skewed consistently for the range 1500 {\textless} Re {\textless} 11,000 while for Re {\textgreater} 11,000 it turns to a symmetric one. The pdf of the other two signals do not show any systematic trends with Re. The most striking difference of the thermopile signal behaviour compared to the other two is its multivalued relationship with Re in the range 2000 {\textless} Re {\textless} 11,000. © 2008 Elsevier Inc. All rights reserved.},
	language = {English},
	number = {8},
	journal = {Experimental Thermal and Fluid Science},
	author = {Stamatopoulos, Ch. and Petropoulos, A. and Mathioulakis, D.S. and Kaltsas, G.},
	year = {2008},
	keywords = {Aerodynamics, Flow regimes, Flow sensors, Gas flowing, Operational modes, Reynolds, Reynolds number, Sensors, Turbulence},
	pages = {1687--1693},
	annote = {Export Date: 29 August 2026; Cited By: 5; Correspondence Address: D.S. Mathioulakis; Fluids Section, National Technical University of Athens (NTUA), 15710 Zografou, 9 Heroon Polytechniou Avenue, Greece; email: mathew@fluid.mech.ntua.gr; CODEN: ETFSE},
