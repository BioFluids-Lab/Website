@inproceedings{papaioannou_new_2004,
 abstract = {Despite the well-known beneficial effects of the intra-aortic balloon pump (IABP) generally, there are still some clinical conditions accompanied by IABP ineffectiveness. The aim of this study was the investigation of the independent effects of arterial stiffness and blood pressure on acute IABP effectiveness. For this purpose, a mock circulatory system and 20 patients with cardiogenic shock due to acute myocardial infarction, were employed. It was shown that IABP acute efficiency was determined primarily by arterial compliance (AC) rather than blood pressure alone. IABP induced low hemodynamic effects in patients with systolic blood pressure \textgreater80 mm Hg but with increased AC, whereas IABP resulted in greater hemodynamic effectiveness in cases with systolic pressure \textless70 mm Hg but lower AC. The present study provides evidence concerning the hemodynamic conditions, which might lead to optimization of IABP or to the prediction of its acute hemodynamic performance, based on both measurements of AC and blood pressure.},
 annote = {Export Date: 29 August 2026; Cited By: 39; Correspondence Address: T.G. Papaioannou; Athens 113 63, Iak. Patatsou 13, Greece; email: theopap@mail.ntua.gr; CODEN: ARORD},
 author = {Papaioannou, T.G. and Mathioulakis, D.S. and Stamatelopoulos, K.S. and Gialafos, E.J. and Lekakis, J.P. and Nanas, J. and Stamatelopoulos, S.F. and Tsangaris, S.G.},
 booktitle = {Artif. Organs},
 doi = {10.1111/j.1525-1594.2004.00080.x},
 isbn = {0160564X (ISSN)},
 keywords = {adult, aged, aorta balloon, Arterial blood, Arterial compliance, arterial pressure, Arterial stiffness, artery compliance, artery wall, Balloons, blood pressure, Blood pressure, Blood vessels, clinical article, clinical practice, Clinical practices, conference paper, Counterpulsation, female, Haemodynamics, hemodynamics, Hemodynamics, human, in vitro study, In-vitro, Intra-aortic balloon counterpulsation, male, Mechanical, Mock circulation, priority journal, regression analysis, Stiffness, systolic blood pressure},
 language = {English},
 note = {Journal Abbreviation: Artif. Organs},
