@article{tsangaris_inverse_1988-1,
 abstract = {In this study a solution for the problem of pulsating flow in rigid tubes is described. The method is applied to the case of the known wall shear stress wave form as opposed to J. R. Womersley's solution, where the pressure gradient along the pipe wall was the known quantity. The solution provides the flow rate and the pressure gradient as well as the instantaneous axial velocity profiles. The method is based on the same governing equation used by Womersley which is the momentum equation along the center-line of the pipe. The equation is derived assuming only the axial velocity components to be non-zero. 4 Refs.},
 annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: ZAMMA},
 author = {Tsangaris, S. and Schims, H. and Athanassiadis, N.},
 issn = {00442267 (ISSN)},
 journal = {Zeitschrift fur angewandte Mathematik und Mechanik},
 keywords = {FLOW OF FLUIDS, INVERSE PROBLEM, MOMENTUM EQUATION, PIPELINES - Fluid Dynamics, PULSATING FLOW},
 language = {English},
 number = {5},
 pages = {t361--t363},
 title = {An inverse problem of pulsating flow in a pipe},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0023829107&partnerID=40&md5=6f21bac28a3a990e7521d43ed2f0235b},
 volume = {68},
 year = {1988}
}
