@article{raptis_oscillating_2021,
 abstract = {The study addresses the oscillating magnetohydrodynamic (MHD) Stokes flow between two parallel plates with periodic reabsorption both spatially and temporally. Two cases are distinguished by applying either (1) transverse or (2) parallel external magnetic field. Analytical solutions of velocity and pressure are derived for both cases and the effect of Womersley and Hartmann number, and the absorption coefficient is examined. The study generalizes existing literature on analytic MHD Stokes flow solutions accounting for periodic boundary conditions both in time and space. The non-oscillating non-MHD Stokes flow in a porous channel (available in the literature) is proven to be a limit of the analytic solution introduced here. The MHD effects are noticeable in flows oscillating with low or moderate frequency but are barely detectable in high-frequency flows even in the presence of strong magnetic fields. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
 annote = {Export Date: 29 August 2026; Cited By: 2; Correspondence Address: M. Xenos; Department of Mathematics, University of Ioannina, Ioannina, 45110, Greece; email: mxenos@uoi.gr},
 author = {Raptis, A. and Manopoulos, C. and Xenos, M. and Tsangaris, S.},
 doi = {10.3390/fluids6040156},
 issn = {23115521 (ISSN)},
 journal = {Fluids},
 keywords = {\jou-international\, Magnetohydrodynamics, Oscillatory stokes flow, Periodic reabsorption, Porous plates},
 language = {English},
 number = {4},
 publisher = {MDPI AG},
 title = {Oscillating magnetohydrodynamic Stokes flow between porous plates with spatiotemporally periodic reabsorption},
 url = {https://doi.org/10.3390/fluids6040156},
 volume = {6},
 year = {2021}
}
