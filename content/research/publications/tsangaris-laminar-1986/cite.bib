@article{tsangaris_laminar_1986,
 abstract = {In the present paper a perturbation method is developed in order to study viscous, laminar flow over a small amplitude wavy solid boundary. The wall is transformed into a straight solid boundary in order to simplify the use of boundary conditions of the problem on the wall. The flow field is calculated numerically up to first perturbation order. separation of the flow is included. © 1986 Springer-Verlag.},
 annote = {Export Date: 29 August 2026; Cited By: 7; CODEN: AMHCA},
 author = {Tsangaris, S. and Potamitis, D.},
 doi = {10.1007/BF01176366},
 issn = {16196937 (ISSN)},
 journal = {Acta Mechanica},
 keywords = {FLOW FIELD, FLOW OF FLUIDS, FLUID MECHANICS - Fluid Dynamics, WAVE PROFILE, WAVY SURFACES},
 language = {English},
 number = {1-4},
 pages = {109--115},
 publisher = {Springer-Verlag},
 title = {On laminar small Reynolds-number flow over wavy walls},
 url = {https://doi.org/10.1007/BF01176366},
 volume = {61},
 year = {1986}
}
