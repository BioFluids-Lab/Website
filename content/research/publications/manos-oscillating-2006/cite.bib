@article{manos_oscillating_2006,
 abstract = {The analytical solution of the equations of motion is presented for a fully developed laminar flow in a curved channel with circular walls, when an oscillating circumferential pressure gradient is imposed (finite gap oscillating Dean flow). The fluid studied, is a viscoelastic (Jeffrey) fluid. The validity of the solution is verified by a finite difference numerical method. © 2006 Elsevier B.V. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 14; Correspondence Address: S. Tsangaris; National Technical University of Athens, School of Mechanical Engineering, 15773 Zografu-Athens, Heroon Polytechniou 9, Greece; email: sgt@fluid.mech.ntua.gr; CODEN: JNFMD},
 author = {Manos, T. and Marinakis, G. and Tsangaris, S.},
 doi = {10.1016/j.jnnfm.2005.11.008},
 issn = {03770257 (ISSN)},
 journal = {Journal of Non-Newtonian Fluid Mechanics},
 keywords = {Channel flow, Dean flow, Equations of motion, Finite difference method, Jeffrey viscoelastic model, Laminar flow, Mathematical models, Oscillating flow, Oscillations, Pressure, Viscoelasticity},
 language = {English},
 number = {1},
 pages = {8--15},
 title = {Oscillating viscoelastic flow in a curved duct - exact analytical and numerical solution},
 url = {https://doi.org/10.1016/j.jnnfm.2005.11.008},
 volume = {135},
 year = {2006}
}
