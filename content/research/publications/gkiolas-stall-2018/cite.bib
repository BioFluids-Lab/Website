@inproceedings{gkiolas_stall_2018,
 abstract = {The continuous development of wind turbine technology gradually leads to larger, more flexible blades with increasing aspect ratios and high tip speeds, while in everyday operation or extreme cases the blades experience stalled flow conditions. These aforementioned facts create the need for further study and physical understanding of stall induced vibrations - stall flutter. In this context an aeroelastic setup was constructed at the NTUA subsonic wind tunnel with a rigid rectangular wing (500 mm x 1400 mm) of a NACA 64-418 airfoil supported by a spring system that enables pitching and plunging motions. The elastic axis of the wing is located 35% of the chord far from the leading edge while its center of mass at 46%. Increasing the free stream velocity (up to Re = 670 000) under various initial static angles of attack, the wing was set at fluid induced oscillations (pitching and plunging). The response of the wing under these conditions was recorded employing two accelerometers and two wire sensors for both the rotational and linear wing displacements. At the same time, in the middle of the wing span thirty (30) fast responsive pressure transducers measured the pressure distribution along the chord, while strain gauges attached to the wing rotating shaft measured the applied unsteady aerodynamic loading. Based on the above simultaneously measured quantities various aspects of the aeroelastic instability of the examined wing were revealed. Copyright © 2018 ASME.},
 annote = {Export Date: 29 August 2026; Cited By: 3; Conference name: ASME 2018 5th Joint US-European Fluids Engineering Division Summer Meeting, FEDSM 2018; Conference date: 15 July 2018 through 20 July 2018; Conference code: 141102; CODEN: FEDSD},
 author = {Gkiolas, D. and Mouzakis, F. and Mathioulakis, D.S.},
 booktitle = {ASME Fluids Eng Div Publ FEDSM},
 doi = {10.1115/FEDSM2018-83162},
 isbn = {08888116 (ISSN); 978-079185155-5 (ISBN)},
 keywords = {Aeroelastic instabilities, Aeroelasticity, Angle of attack, Aspect ratio, Atmospheric movements, Boundary layers, Continuous development, Energy conversion, Fluid mechanics, Fluid structure interaction, Flutter (aerodynamics), Free-stream velocity, Induced vibrations, Rigid rectangular wing, Rigid wings, Stall indicators, Subsonic wind tunnels, Transport properties, Turbomachine blades, Unsteady aerodynamics, Vortex flow, Wind power, Wind tunnels, Wind turbine technology, Wind turbines},
 language = {English},
