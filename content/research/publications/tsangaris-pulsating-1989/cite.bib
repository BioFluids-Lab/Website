@article{tsangaris_pulsating_1989,
 abstract = {A mathematical model for pulsating flow of a viscous incompressible fluid in an initially stressed elastic tube with anisotropic structure is developed and an analysis of the propagation of pressure waves is presented. The theoretical model can be applied to the study of blood flow in arteries, and its solution leads to a dispersion equation relating wave number with frequency and the rheological parameters of the wall. Determination of fluid velocities and displacement components is obtained. © 1989 IFMBE.},
 annote = {Export Date: 29 August 2026; Cited By: 8; CODEN: MBECD},
 author = {Tsangaris, S. and Drikakis, D.},
 doi = {10.1007/BF02442174},
 issn = {17410444 (ISSN)},
 journal = {Medical & Biological Engineering & Computing},
 keywords = {Animal, Arterial blood flow, Arterial Blood Flow, Arteries, artery blood flow, Biological Materials--Blood, Biomedical Engineering, Elasticity, Flow of Fluids--Pulsatile Flow, Initially stressed anisotropic elastic tube, Initially Stressed Anisotropic Elastic Tubes, Mathematical Models, Mathematics, methodology, Models, Cardiovascular, nonbiological model, pulsatile flow, Pulsatile Flow, Pulsating Blood Flow, Pulsating flow, Regional Blood Flow, Rheology, Stresses, theoretical study, Tubes--Elasticity},
 language = {English},
 number = {1},
 pages = {82--88},
 publisher = {Kluwer Academic Publishers},
 title = {Pulsating blood flow in an initially stressed, anisotropic elastic tube: linear approximation of pressure waves},
 url = {https://doi.org/10.1007/BF02442174},
 volume = {27},
 year = {1989}
}
