@article{tsangaris_exact_2007-1,
 abstract = {This paper presents an extension of the exact solution of the steady laminar axisymmetric flow in a straight pipe of circular cross section with porous wall, given by R.M. Terrill, to the case of unsteady wall injection and/or suction. The cases of the pulsating parabolic profile and of the developed pulsating flow are investigated as examples. The pulsating flow in porous ducts has many applications in biomedical engineering and in other engineering areas. © 2006 Elsevier B.V. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 24; Correspondence Address: S. Tsangaris; School of Mechanical Engineering, Fluids Section, National Technical University of Athens, 15773 Zografou- Athens, Heroon Polytechniou 9, Greece; email: sgt@fluid.mech.ntua.gr},
 author = {Tsangaris, S. and Kondaxakis, D. and Vlachakis, N.W.},
 doi = {10.1016/j.cnsns.2005.12.009},
 issn = {10075704 (ISSN)},
 journal = {Communications in Nonlinear Science and Numerical Simulation},
 keywords = {Biomedical engineering, Exact solution, Laminar flow, Navier Stokes equations, Navier-Stokes, Pipe flow, Porous wall, Pulsatile flow, Pulsating parabolic profile, Steady flow, Unsteady laminar flow},
 language = {English},
 number = {7},
 pages = {1181--1189},
 publisher = {Elsevier},
 title = {Exact solution for flow in a porous pipe with unsteady wall suction and/or injection},
 url = {https://doi.org/10.1016/j.cnsns.2005.12.009},
 volume = {12},
 year = {2007}
}
