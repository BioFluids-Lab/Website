@inproceedings{karageorgos_self-powered_2017,
 abstract = {In this paper, we present the potential of a device, originally designed for energy harvesting, to form a self-powered medical implant that monitors critical parameters of the cardiovascular system. The original design consists of a coil that deforms with an artery inside magnetic field applied by two permanent magnets. We fabricated the device, and developed appropriate experimental setup that simulates blood flow and arterial wall pulsation with adjustable frequency and pressure. The voltage and power of the moving coil, as well as the pressure inside the tube simulating the pulsating artery were measured at different frequencies. In-vitro experiments and theoretical analysis showed that the voltage induced across the coil’s terminals can provide information on blood pressure, heart rate, arterial wall deformation and velocity. © ICST Institute for Computer Sciences, Social Informatics and Telecommunications Engineering 2017.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: K. Nikita; Biomedical Simulations and Imaging Laboratory, Mobile Radiocommunications Laboratory, School of Electrical and Computer Engineering, National Technical University of Athens, Athens, 15780, Greece; email: knikita@ece.ntua.gr; Conference name: 6th International Conference on Wireless Mobile Communication and Healthcare, MobiHealth 2016; Conference date: 14 November 2016 through 16 November 2016; Conference code: 192949},
 author = {Karageorgos, G.M. and Manopoulos, C. and Tsangaris, S. and Nikita, K.},
 booktitle = {Lect. Notes Inst. Comput. Sci. Soc. Informatics Telecommun. Eng.},
 doi = {10.1007/978-3-319-58877-3_1},
 editor = {Rizzo G. and Perego P. and Andreoni G.},
 isbn = {18678211 (ISSN); 978-331958876-6 (ISBN)},
 keywords = {Adjustable frequency, Arterial wall, Arterial wall deformation, Blood pressure, Blood pressure monitoring, Blood-pressure monitoring, Cardiovascular system, Deformation, Different frequency, Electromagnetic devices, Electromagnets, Energy harvesting, Health care, Implantable devices, Implants (surgical), Medical implants, Mobile telecommunication systems, Monitoring, Self-powered},
 language = {English},
