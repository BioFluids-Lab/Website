@article{mouratidou_linear_2026,
 abstract = {An investigation of abdominal aortic aneurysms (AAAs) is performed based on medical Computed Tomography (CT) images. The images are transformed into 3D surface models to simulate deformation behavior of AAAs and estimate the rupture risk. The finite element method (FEM) with nonlinear hyperelastic Yeoh material model and the linear model for comparison are used. The aorta has been modelled with the shell theory, with appropriate adjustments to take into account the intraluminal thrombus. Numerical results are obtained for the maximum value of the von Mises stresses and strains. The introduced techniques can provide sufficient estimates for the displacements at inaccessible points, like virtual sensors, which can be used for rupture prediction within an integrated artificial intelligence tool. © The Author(s) 2026.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: G.E. Stavroulakis; Computational Mechanics and Optimization Laboratory, School of Production Engineering and Management, Technical University of Crete, Chania, Crete, 73100, Greece; email: gestavroulakis@tuc.gr; CODEN: MECCB},
 author = {Mouratidou, A.D. and Kladovasilakis, N. and Raptis, A. and Tsantrizos, P. and Moulakakis, K.G. and Kakisis, J. and Manopoulos, C. and Drosopoulos, G.A. and Stavroulakis, G.E.},
 doi = {10.1007/s11012-026-02137-z},
 issn = {00256455 (ISSN)},
 journal = {Meccanica},
 keywords = {Abdominal aortic aneurysm, Biomechanics, Finite element analysis, Hyperelastic material model, Nonlinear elasticity},
 language = {English},
 number = {3},
 publisher = {Springer Science and Business Media B.V.},
 title = {Linear and nonlinear FEM modeling of abdominal aortic aneurysms based on computed tomography images},
 url = {https://doi.org/10.1007/s11012-026-02137-z},
 volume = {61},
 year = {2026}
}
