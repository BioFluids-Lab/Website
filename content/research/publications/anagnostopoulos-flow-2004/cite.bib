@article{anagnostopoulos_flow_2004,
 abstract = {The flow field around a time-dependent 3-D asymmetric tube constriction was studied and comparisons were made with the corresponding 2-D case. Both experimental (LDV-PIV) and numerical (finite volume) tools were employed for Re \textless 1000, St \textless 0.3 and 50% maximum passage reduction. The basic features of the flow were 3-D separation and reattachment, vortex generation especially after the middle of the cycle (max. constriction), and vortex destruction before the end of the cycle. The snake-type shape of the streamlines, known from the 2-D case, was not observed on the symmetry plane of the examined flow due to the secondary flow action. © 2003 Elsevier Ltd. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 6; Correspondence Address: D.S. Mathioulakis; School of Mech. Eng./Fluids Section, National Technical Univ. of Athens, Zografos, Athens 15710, 9 Heroon Polytechniou Ave., Greece; email: mathew@fluid.mech.ntua.gr},
 author = {Anagnostopoulos, J. and Mathioulakis, D.S.},
 doi = {10.1016/j.jfluidstructs.2003.10.002},
 issn = {08899746 (ISSN)},
 journal = {Journal of Fluids and Structures},
 keywords = {constriction, Finite volume method, finite volume technique, flow around object, flow field, Flow fields, flow measurement, flow separation, Fluid dynamics, laser Doppler velocimeter, particle image velocimeter, particle image velocimetry, Secondary flow, Stream flow, Streamlines, vortex, Vortex flow},
 language = {English},
 number = {1},
 pages = {49--62},
 publisher = {Academic Press},
 title = {A flow study around a time-dependent 3-D asymmetric constriction},
 url = {https://doi.org/10.1016/j.jfluidstructs.2003.10.002},
 volume = {19},
 year = {2004}
}
