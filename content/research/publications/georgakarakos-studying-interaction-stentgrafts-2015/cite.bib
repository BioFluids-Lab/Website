@article{georgakarakosStudyingInteractionStentgrafts2015,
 abstract = {Since the advent of endovascular repair of aortic aneurysms (EVAR), clinical focus has been on preventing loss of sealing at the level of the infrarenal neck, which leads to type I endoleak and repressurization of the aneurysm sac. Enhanced mechanisms for central fixation and seal have consequently lowered the incidence of migration and endoleaks. However, endograft limb thrombosis and its causal mechanisms have not been addressed adequately in the literature. This article reviews the pathophysiological mechanisms associated with limb thrombosis in order to facilitate better clinical judgment to prevent iliac adverse effects.},
 author = {Georgakarakos, Efstratios and Raptis, Anastasios and Schoretsanitis, Nikolaos and Bisdas, Theodosios and Beropoulis, Efthymios and Georgiadis, George and Matsagkas, Miltiadis and Xenos, Michalis},
 doi = {10.1177/1526602815583494},
 issn = {1526-6028},
 journal = {Journal of Endovascular Therapy},
 keywords = {\jou-international\},
 language = {en},
 month = {June},
 number = {3},
 pages = {413--420},
 publisher = {SAGE Publications Inc},
 shorttitle = {Studying the interaction of stent-grafts and treated abdominal aortic aneurysms},
 title = {Studying the interaction of stent-grafts and treated abdominal aortic aneurysms: time to move caudally!},
 url = {https://doi.org/10.1177/1526602815583494},
 urldate = {2025-07-01},
 volume = {22},
 year = {2015}
}
