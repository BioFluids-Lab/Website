@article{tsangaris_longitudinal_1986,
 abstract = {The dispersion of a diffusing substance along a channel or pipe is augmented if the channel walls (resp. pipe wall) are moving in the lateral direction. The fluid in the present theoretical investigation is supposed to be inviscid. The longitudinal dispersion enhancement is evaluated analytically and the expressions for various movements of the walls are given in simple formulas. © 1986 Birkhäuser Verlag.},
 annote = {Export Date: 29 August 2026; Cited By: 3},
 author = {Tsangaris, S.},
 doi = {10.1007/BF00953679},
 issn = {14209039 (ISSN)},
 journal = {ZAMP Journal of Applied Mathematics and Physics},
 language = {English},
 number = {6},
 pages = {895--909},
 publisher = {Birkhäuser-Verlag},
 title = {Longitudinal dispersion in a duct with moving walls},
 url = {https://doi.org/10.1007/BF00953679},
 volume = {37},
 year = {1986}
}
