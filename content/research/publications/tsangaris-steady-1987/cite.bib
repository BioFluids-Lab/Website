@article{tsangaris_steady_1987,
 abstract = {Die pulsierende Strömung spielt eine entscheidenhe Rolle bei der Entstehung atheroskleroti-scher Ablagerungen in den Blutgefäßen und bei der Schädigung der Endothelzellen, wobei die Stenosen besonders beachtet werden müssen. Geschwindigkeiten mit einem Laser-Doppler-Anemometer wurden wiederholt in der Nähe eines Stenosenmodells ausgeführt, um Aufschluß über das stationäre und pulsierende Geschwindigkeitsfeld zu erhalten. Mit einem Ultraschallmeßgerät wurden die Geschwindigkeiten an verschiedenen Punkten in der Stenose gemessen und die Genauigkeit dieser Messungen mit dem der Laser-Doppler-Sonde verglichen. Dadurch kann eine bessere Aussage über die Ultraschallsignale gemacht werden. Für die Meßmethoden wurden erstmals erythrozytenförmige Kunststoffpartikel verwendet. Die stationäre Strömung wurde mittels einer strömungsdoppelbrechenden Flüssigkeit sichtbar gemacht. © 1987, Walter de Gruyter. Alle Rechte vorbehalten.},
 annote = {Export Date: 29 August 2026; Cited By: 0},
