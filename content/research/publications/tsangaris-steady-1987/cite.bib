 issn = {00135585 (ISSN)},
 journal = {Biomedizinische Technik},
 keywords = {Arterial Occlusive Diseases, Arterial stenosis pulsating flow, Arteries, artery, artery occlusion, article, biological model, blood flow, blood flow velocity, Blood Flow Velocity, English Abstract, flow kinetics, human, Human, model, Models, Cardiovascular, mung, nonbiological model, nonhuman, pathophysiology, peripheral occlusive artery disease, peripheral vascular system, Rheology, rter Arterielle Stenose pulsierende Strö, Schlü, sselwö, Support, Non-U.S. Gov't, theoretical study},
 language = {German},
 number = {1-2},
 pages = {2--8},
 shorttitle = {Stationäre und pulsierende Strömung in einem künstlichen Modell einer arteriellen Stenose},
 title = {Steady and pulsating flow in an artificial model of arterial stenosis},
 url = {https://doi.org/10.1515/bmte.1987.32.1-2.2},
