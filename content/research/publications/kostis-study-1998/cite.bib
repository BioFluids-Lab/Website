 editor = {Carabelas A. and Di Lazzaro P. and Torre A. and Baldacchini G.},
 isbn = {0277786X (ISSN)},
 keywords = {Angle of attack, Cross correlation techniques, Cross correlations, Cross-correlation, Double circular arcs, Flow visualization, Hydraulic machines, Image analysis, Laser applications, Particle image velocimetries, Particle image velocimetry technique, PIV, Surface waters, Technical universities, Velocimeters, Velocity, Velocity measurement, Vortex flow, Vortex shedding, Vortical structures, Vorticity},
