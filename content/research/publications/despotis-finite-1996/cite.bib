@article{despotis_finite_1996,
 abstract = {The extrudate swell phenomenon is analysed by solving, simultaneously, the Navier-Stokes equations along with the continuity equation by means of a finite volume method. In this work, the planar jet flows of incompressible viscous Newtonian and power-law fluids for Reynolds numbers as high as 75 are simulated. The method uses the velocity components and pressure as the primitive variables and employs an unstructured triangular grid and triangular or polygonal control volume for each separate variable. The numerical results show good agreement with previously reported experimental and numerical results. Shear thickening results in an increase in swelling ratio, while the introduction of surface tension results in a describes in swelling ratio.},
 annote = {Export Date: 29 August 2026; Cited By: 7; CODEN: INMFE},
 author = {Despotis, G.K. and Tsangaris, S.},
 doi = {10.1108/09615539610131271},
 issn = {09615539 (ISSN)},
 journal = {International Journal of Numerical Methods for Heat and Fluid Flow},
 keywords = {Extrudate swell phenomenon, Finite volume method, Incompressible die swell, Incompressible die-swell, Incompressible flow, jet flow, Jets, Mathematical models, Navier Stokes equations, Navier-Stokes equations, Newtonian flow, Newtonian liquids, Numerical methods, Planar jet flows, Polygonal control volume, power law fluid, Power law model, Power-law model, Power-Law model, Pressure effects, Problem solving, Reynolds number, Surface tension, swell, Swelling, Unstructured finite volume, Velocity measurement, Viscous flow},
 language = {English},
 number = {6},
 pages = {65--83},
 publisher = {Emerald Group Publishing Ltd.},
 title = {A finite volume method for the solution of the extrudate swell problem on unstructured triangular meshes},
 url = {https://doi.org/10.1108/09615539610131271},
 volume = {6},
 year = {1996}
}
