@article{mathioulakis_pulsating_1989,
 abstract = {Two-component LDV measurements are obtained over an ellipse at an angle of attack. Detailed information is provided for the stagnation region, the two separation regions and the two free shear layers. Steady and unsteady flow measurements are presented. Periodic disturbances in the oncoming stream are introduced and ensemble-averaged unsteady data are obtained. An integral picture of laminar flow over a lifting body with no sharp edges is thus presented, which is readily available for comparison with asymptotic or numerical calculations. © 1989, Cambridge University Press. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 5},
 author = {Mathioulakis, D.S. and Telionis, D.P.},
 doi = {10.1017/S0022112089000856},
 issn = {00221120 (ISSN)},
 journal = {Journal of Fluid Mechanics},
 keywords = {Flow of Fluids, Fluid Dynamics, Free Shear Layers, Lifting Body Laminar Flow, Unsteady Flow Measurements, Velocimeters--Laser Doppler},
 language = {English},
 pages = {99--121},
 title = {Pulsating flow over an ellipse at an angle of attack},
 url = {https://doi.org/10.1017/S0022112089000856},
 volume = {201},
 year = {1989}
}
