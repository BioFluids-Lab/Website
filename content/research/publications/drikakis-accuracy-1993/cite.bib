@article{drikakis_accuracy_1993,
 abstract = {A study of viscous and inviscid hypersonic flows using generalized upwind methods is presented. A new family of hybrid flux‐splitting methods is examined for hypersonic flows. The hybrid method is constructed by the superposition of the flux‐vector‐splitting (FVS) method and second‐order artificial dissipation in the regions of strong shock waves. The conservative variables on the cell faces are calculated by an upwind extrapolation scheme to third‐order accuracy. A second‐order‐accurate scheme is used for the discretization of the viscous terms. The solution of the system of equations is achieved by an implicit unfactored method. In order to reduce the computational time, a local adaptive mesh solution (LAMS) method is proposed. The LAMS method combines the mesh‐sequencing technique and local solution of the equations. The local solution of either the Euler or the NAVIER‐STOKES equations is applied for the region of the flow field where numerical disturbances die out slowly. Validation of the Euler and NAVIER‐STOKES codes is obtained for hypersonic flows around blunt bodies. Real gas effects are introduced via a generalized equation of state. Copyright © 1993 John Wiley & Sons, Ltd},
 annote = {Export Date: 29 August 2026; Cited By: 22},
 author = {Drikakis, D. and Tsangaris, S.},
 doi = {10.1002/fld.1650160902},
 issn = {02712091 (ISSN)},
 journal = {International Journal for Numerical Methods in Fluids},
 keywords = {Bodies of revolution, Codes (symbols), Computational fluid dynamics, Computational methods, Differential equations, Equations of state, Euler/Navier Stokes equations, Euler/NAVIER‐STOKES equations, Flux vector splitting methods, Gas dynamics, Generalized upwind methods, Hybrid flux splitting methods, Hypersonic flow, Hypersonic flows, Implicit unfactored method, Local adaptive mesh solution, Mathematical models, Mesh sequencing technique, Numerical methods, Real gas, Real gas hypersonic flows, Second order artificial dissipation, Shock waves, Upwind scheme, Viscous flow},
 language = {English},
 number = {9},
 pages = {759--775},
 title = {On the accuracy and efficiency of CFD methods in real gas hypersonics},
 url = {https://doi.org/10.1002/fld.1650160902},
 volume = {16},
 year = {1993}
}
