@article{karageorgos_approach_2018,
 abstract = {Though medical implantable devices are highly suitable for continuous and real-time patient monitoring, their battery replacement is a costly and complicated procedure. To extend the functional life of medical implants, energy harvesting methods have been investigated that convert the motions of the cardiovascular system to electrical energy. In this paper, we present the potential of such an energy harvester to operate as a sensor for cardiovascular parameters estimation, thus enabling the realization of a novel self-powered implantable cardiovascular monitor. This energy harvester is based on electromagnetic induction and exploits a conductive coil that moves along with an artery inside a magnetic field, applied by two permanent ring magnets. A similar device was fabricated and in order to test it, an experimental setup was developed that simulates arterial wall motion. Our in vitro experiments demonstrated that the voltage induced in the coil is linearly related with arterial wall velocity and heart rate (coefficient of determination R2 \textgreater 0.99). Moreover, the induced voltage was associated with blood pressure and the deforming artery's radius through a second-order polynomial fit (R2 \textgreater 0.99). © 2017 IEEE.},
 annote = {Export Date: 29 August 2026; Cited By: 7},
 author = {Karageorgos, G.M. and Manopoulos, C. and Kiourti, A. and Karagiannis, A. and Tsangaris, S. and Nikita, K.S.},
 doi = {10.1109/JSEN.2017.2699123},
 issn = {1530437X (ISSN)},
 journal = {IEEE Sensors Journal},
 keywords = {Arterial wall, Arterial wall motion, Battery replacements, Blood pressure, Blood pressure sensor, Cardiovascular monitoring, Cardiovascular parameters, Coefficient of determination, Electromagnetic induction, Energy harvesting, Implantable devices, Implants (surgical), Medical implantable devices, Patient monitoring, Second-order polynomial, Self-powered, Self-powered sensor},
 language = {English},
 number = {1},
 pages = {83--93},
 publisher = {Institute of Electrical and Electronics Engineers Inc.},
 title = {An approach for self-powered cardiovascular monitoring based on electromagnetic induction},
 url = {https://doi.org/10.1109/JSEN.2017.2699123},
 volume = {18},
 year = {2018}
}
