@article{stamatopoulos_experimental_2011,
 abstract = {The velocity field in a patient-specific abdominal aneurysm model including the aorto-iliac bifurcation was measured by 2D PIV. Phase-averaged velocities obtained in 14 planes reveal details of the flow evolution during a cycle. The aneurysm expanding asymmetrically toward the anterior side of the aorta causes the generation of a vortex at its entrance, covering the entire aneurysm bulge progressively before flow peak. The fluid entering the aneurysm impinges on the left side of its distal end, following the axis of the upstream aorta segment, causing an increased flow rate in the left (compared to the right) common iliac artery. High shear stresses appear at the aneurysm inlet and outlet as well as along the posterior wall, varying proportionally to the flow rate. At the same regions, elevated flow disturbances are observed, being intensified at flow peak and during the deceleration phase. Low shear stresses are present in the recirculation region, being two orders of magnitude smaller than the previous ones. At flow peak and during the deceleration phase, a clockwise swirling motion (viewed from the inlet) is present in the aneurysm due to the out of plane curvature of the aorta. © Springer-Verlag 2010.},
 annote = {Export Date: 29 August 2026; Cited By: 38; Correspondence Address: D. S. Mathioulakis; School of Mechanical Engineering, Fluids Section, National Technical University of Athens, Zografos, Athens 15710, 9 Heroon Polytechniou Ave., Greece; email: mathew@fluid.mech.ntua.gr; CODEN: EXFLD},
 author = {Stamatopoulos, C. and Mathioulakis, D.S. and Papaharilaou, Y. and Katsamouris, A.},
 doi = {10.1007/s00348-010-1034-6},
 issn = {07234864 (ISSN)},
 journal = {Experiments in Fluids},
 keywords = {2-D PIV, Abdominal aortic aneurysms, Aorto-iliac bifurcation, Blood vessels, Deceleration phase, Flow disturbances, Flow evolution, Flow rate, Iliac arteries, Inlet flow, Orders of magnitude, Out-of plane, Phase-averaged velocity, Recirculation regions, Shear flow, Shear stress, Swirling motion, Velocity, Velocity field},
 language = {English},
 number = {6},
 pages = {1695--1709},
 title = {Experimental unsteady flow study in a patient-specific abdominal aortic aneurysm model},
 url = {https://doi.org/10.1007/s00348-010-1034-6},
 volume = {50},
 year = {2011}
}
