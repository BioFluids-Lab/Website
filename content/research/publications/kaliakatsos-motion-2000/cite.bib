@article{kaliakatsos_motion_2000,
 abstract = {The motion of deformable drops in pipes and channels is studied using a level set approach in order to capture the interface of two fluids. The interface is described as the zero level set of a smooth function, which is defined to be the signed normal distance from the interface. In order to solve the Navier-Stokes equations, a second-order projection method is used. The dimensionless parameters of the problem are the relative size of the drop to the size of the pipe or channel cross-section, the ratio of the drop viscosity to the viscosity of the suspending fluid and the relative magnitude of viscous forces to the surface tension forces. The shape of the drop, the velocity field and the additional pressure loss due to the presence of the drop, varying systematically with the above-mentioned dimensionless parameters, are computed. Copyright © 2000 John Wiley & Sons, Ltd.; The motion of deformable drops in pipes and channels is studied using a level set approach in order to capture the interface of two fluids. The interface is described as the zero level set of a smooth function, which is defined to be the signed normal distance from the interface. In order to solve the Navier-Stokes equations, a second-order projection method is used. The dimensionless parameters of the problem are the relative size of the drop to the size of the pipe or channel cross-section, the ratio of the drop viscosity to the viscosity of the suspending fluid and the relative magnitude of viscous forces to the surface tension forces. The shape of the drop, the velocity field and the additional pressure loss due to the presence of the drop, varying systematically with the above-mentioned dimensionless parameters, are computed.},
 annote = {Export Date: 29 August 2026; Cited By: 10; Correspondence Address: S. Tsangaris; Dept. of Mechanical Engineering, National Technical Univ. of Athens, 15710 Zografou, Athens, PO Box 64070, Greece; email: sgt@fluid.mech.ntua.gr; CODEN: IJNFD},
 author = {Kaliakatsos, Ch. and Tsangaris, S.},
 doi = {10.1002/1097-0363(20001215)34:7<609::AID-FLD73>3.0.CO;2-1},
 issn = {02712091 (ISSN)},
 journal = {International Journal for Numerical Methods in Fluids},
 keywords = {Algorithms, Boundary integral method, channel, Channel flow, Deformable drop, Deformable drops, deformation, Drop breakup, Drop motion, droplet, Equations of motion, fluid interface, Integration, Interfaces (materials), Level set approach, Navier Stokes equations, Numerical methods, pipe, Pipe flow, Surface tension, viscosity, Viscosity of liquids},
 language = {English},
 number = {7},
 pages = {609--626},
 publisher = {John Wiley & Sons Ltd},
 title = {Motion of deformable drops in pipes and channels using Navier-Stokes equations},
 url = {https://doi.org/10.1002/1097-0363(20001215)34:7%3C609::AID-FLD73%3E3.0.CO;2-1},
