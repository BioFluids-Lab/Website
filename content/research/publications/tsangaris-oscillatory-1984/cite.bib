@article{tsangaris_oscillatory_1984,
 abstract = {In this paper the viscous flow due to an oscillating pressure gradient along a straight circular annular pipe with rigid walls is discussed. The amplitude and the phase difference of the oscillating velocity are obtained in analytical closed form. The discussion is limited to two dimensionless parameters, the Wormersley parameter and the ratio between the radii of the annulus. The limiting cases of steady flow inside an annulus and of oscillating flow in a tube of circular cross section are also given.},
 annote = {Export Date: 29 August 2026; Cited By: 29; CODEN: JMTAD},
 author = {Tsangaris, S.},
 issn = {07507240 (ISSN)},
 journal = {Journal de mecanique theorique et appliquee},
 keywords = {FLOW OF FLUIDS, MATHEMATICAL TECHNIQUES - Boundary Value Problems},
 language = {English},
 number = {3},
 pages = {467--478},
 title = {Oscillatory flow of an incompressible, viscous fluid in a straight annular pipe},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0021579212&partnerID=40&md5=3d5cb00b14bc6e5f0abdb9165f1a59f8},
 volume = {3},
 year = {1984}
}
