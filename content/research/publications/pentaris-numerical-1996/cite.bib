@article{pentaris_numerical_1996,
 abstract = {In this paper an implicit projection method for the solution of the two-dimensional, time-dependent, incompressible Navier - Stokes equations is presented. The basic principle of this method is that the evaluation of the time evolution is split into intermediate steps. The computational method is based on the approximate factorization technique. The coupled approach is used to link the equations of motion and the turbulence model equations. The standard k - ∈ turbulence model is used. The current methodology, which has been tested extensively for steady problems, is now applied for the numerical simulation of unsteady flows. Several cases were tested, such as plane or axisymmetric channels, a backward-facing step, a square cavity and an axisymmetric stenosis.},
 annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: IJNFD},
 author = {Pentaris, A. and Tsangaris, S.},
 doi = {10.1002/(sici)1097-0363(19961115)23:9<897::aid-fld461>3.0.co;2-#},
 issn = {02712091 (ISSN)},
 journal = {International Journal for Numerical Methods in Fluids},
 keywords = {Approximate factorization technique, Laminar flow, Navier-Stokes equations, Projection method, Turbulent flow, Unsteady flow},
 language = {English},
 number = {9},
 pages = {897--921},
 publisher = {John Wiley and Sons Ltd},
 title = {Numerical simulation of unsteady viscous flows using an implicit projection method},
 url = {https://doi.org/10.1002/(SICI)1097-0363(19961115)23:9<897::AID-FLD461>3.0.CO;2-%23},
 volume = {23},
 year = {1996}
}
