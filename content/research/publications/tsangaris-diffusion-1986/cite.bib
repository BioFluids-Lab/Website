@article{tsangaris_diffusion_1986,
 abstract = {Physiological pumps, like heart, produce flows by alternate contraction and expansion of the vessel. These systems can be modeled by a semi-infinite pipe with one end closed, which prevents only axial motion of the fluid leaving radial motion completely unrestricted. In the present study the problem of the advection of a property in the two-dimensional unsteady flow field produced by expansion or contraction of the channel walls is studied analytically.},
 annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: ZAMMA},
 author = {Tsangaris, S. and Athanassiadis, N.},
 issn = {00442267 (ISSN)},
 journal = {Zeitschrift fur angewandte Mathematik und Mechanik},
 keywords = {DIFFUSION, FLOW OF FLUIDS, MATHEMATICAL TECHNIQUES - Boundary Value Problems, MOVING WALLS},
 language = {English},
 number = {4},
 pages = {267--269},
 title = {Diffusion in a channel with moving walls},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0022581143&partnerID=40&md5=eb20a662db4467cd4d90a519d52ce38a},
