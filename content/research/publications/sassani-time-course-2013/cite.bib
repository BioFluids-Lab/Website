@article{sassani_time-course_2013,
 abstract = {Arteriovenous fistulae have been previously created by our group, through implantation of e-PTFE grafts between the carotid artery and jugular vein in healthy pigs, to gather comprehensive data on the time-course of the adapted geometry, composition, and biomechanical properties of the venous wall exposed to chronic increases in pressure and flow. The aim of this study was to mathematically assess the biomechanical adaptation of venous wall, by characterizing our previous in vitro inflation/extension testing data obtained 2, 4, and 12 weeks post-fistula, using a microstructure-based material model. Our choice for such a model considered a quadratic function for elastin with a four-fiber family term for collagen, and permitted realistic data characterization for both overloaded and control veins. As structural validation to the hemodynamically-driven differences in the material response, computerized histology was employed to quantitate the composition and orientation of collagen and elastin-fiber networks. The parameter values optimized showed marked differences among the overloaded and control veins, namely decrease in the quadratic function parameters and increase in the four-fiber family parameters. Differences among the two vein types were highlighted with respect to the underlying microstructure, namely the reduced elastin and increased collagen contents induced by pressure and flow-overload. Explicit correlations were found of the material parameters with the two basic scleroprotein contents, substantiating the material model used and the characterization findings presented. Our results are expected to improve the current understanding of the dynamics of venous adaptation under sustained pressure- and flow-overload conditions, for which data are largely unavailable and contradictory. © 2013 Elsevier Ltd.},
 annote = {Export Date: 29 August 2026; Cited By: 10; Correspondence Address: D.P. Sokolis; Laboratory of Biomechanics, Center for Experimental Surgery, Biomedical Research Foundation of the Academy of Athens, Athens, Greece; email: DimitrisSokolis@ath.forthnet.gr; CODEN: JBMCB},
 author = {Sassani, S.G. and Theofani, A. and Tsangaris, S. and Sokolis, D.P.},
 doi = {10.1016/j.jbiomech.2013.07.011},
 issn = {18732380 (ISSN)},
 journal = {Journal of Biomechanics},
 keywords = {adaptation, Adaptation, Physiological, animal experiment, animal model, animal tissue, Animals, Arteriovenous fistula, Arteriovenous Fistula, Arteriovenous fistulas, article, automation, Biomechanical properties, biomechanics, Biomechanics, Carotid Arteries, collagen, Collagen, composite material, Constitutive modeling, Constitutive models, Data characterization, elastin, Elastin, equipment design, experimental pig, Glycoproteins, hemodynamic parameters, hemodynamics, histology, internal jugular vein, Jugular Veins, male, Male, Material modeling, Material parameter, Material response, mathematical computing, mathematical model, mechanical stress, Microstructure, Models, Biological, nonhuman, Pressure, Pressure- and flow-overload, priority journal, process design, process development, process optimization, process technology, Quadratic function, quantitative study, Regional Blood Flow, scleroprotein, Stress, Mechanical, structure analysis, Swine, validation process, vein graft, Vein remodeling, vein wall, venous pressure},
 language = {English},
