@article{anastasiadis_strategies_2026,
 abstract = {Peristaltic pumps are commonly used in medical applications like cardiopulmonary bypass and drug infusion due to their minimal contact with bio-fluids and precise flow control. However, these pumps generate inherent flow pulsations, which can cause backflow or strain on the fluid, potentially leading to issues like hemolysis in blood. This study investigated the mechanics of pulsation in the output mass flow rate of peristaltic pumps and explored strategies for reduction. Using an optimized tube geometry, 3D fluid–structure interaction simulations were conducted under realistic conditions. Tracking the pressure variations before and after each roller revealed a direct correlation with the transient drops in mass flow rate during roller disengagement. By adjusting geometric parameters, results indicated that selecting an optimal roller diameter could reduce pulsation by 20%. Variations in tube wall stiffness and curvature radius had minimal impact on mass flow rate. Notably, removing external support from the pump housing near the outlet reduces flow pulsation by up to 23% by enabling a smoother disengagement of the leading roller. Finally, this paper introduces a cost-effective volumetric approach to estimate mass flow rate trends during full tube occlusion, showing good agreement with the CFD model data. © International Federation for Medical and Biological Engineering 2025.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: N. Rogkas; Laboratory of Machine Design and Dynamics, National Technical University of Athens, Athens, Greece; email: nrogkas@mail.ntua.gr; CODEN: MBECD},
 author = {Anastasiadis, A. and Rogkas, N. and Tsoukalis, A. and Manopoulos, C. and Spitas, V.},
 doi = {10.1007/s11517-025-03464-1},
 issn = {01400118 (ISSN)},
 journal = {Medical and Biological Engineering and Computing},
 keywords = {Article, Biofluids, Blood, Cardiopulmonary bypass, computational fluid dynamics, Computational fluid dynamics, controlled study, Cost benefit analysis, Cost effectiveness, cost effectiveness analysis, Design, Drug infusion, Elastic tube, Elastic tubes, equipment design, Flow pulsation, flow rate, Flow rate, Flow-rate pulsations, geometry, Mass transfer, Mass-flow rate, Medical applications, Peristaltic pump, physical model, prediction, pressure, pulsatile flow, Pulsatile flow, Pulsating flow, Pumps, rigidity, Rollers (machine components), rotation, simulation, Simulation, three-dimensional imaging, Tube design, Tubes (components), Young modulus},
 language = {English},
 number = {2},
 pages = {531--545},
 publisher = {Springer Science and Business Media Deutschland GmbH},
 title = {Strategies to predict and decrease flow rate pulsation in a rotary peristaltic pump with novel tube design},
 url = {https://doi.org/10.1007/s11517-025-03464-1},
 volume = {64},
