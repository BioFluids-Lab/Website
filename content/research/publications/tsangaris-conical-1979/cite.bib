@article{tsangaris_conical_1979,
 abstract = {Using a transonic approximation, the paper deals analytically with the supersonic flow around slender yawed circular cones with attached shock wave. This represents an extension of the axisymmetric problem calculated by Oswatitsch and Sjoedin in 1954. According to a paper by Oswatitsch and Tsangaris, the solutions depend on two parameters of similarity. Results are compared with a pole-dipole approximation, the acoustic approximation and the data of the Sims tables.},
 annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: ZFWED},
 author = {Tsangaris, Sokrates},
 journal = {Z Flugwiss Weltraumforsch},
 keywords = {Aerodynamics, FLOW OF FLUIDS - Cones},
 language = {English},
 number = {2},
 pages = {87--97},
 shorttitle = {KEGELIGE UEBERSCHALLSTROEMUNG AN ANGESTELLTEN KREISKEGELN IN SCHALLNAEHE.},
 title = {Conical supersonic flow around yawed circular cones in the transonic region},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0018445318&partnerID=40&md5=a4810a543fc99e26990435b887a7cdc2},
 volume = {3},
 year = {1979}
}
