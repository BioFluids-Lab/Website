@article{sassani_layer-dependent_2015,
 abstract = {Mechanical testing and in-depth characterization of the abdominal aortic aneurysm wall from fifteen patients undergoing open surgery was performed to establish the layer-dependent tissue properties that are non-available in the literature. Quantitative microscopic evaluation was performed to identify the spatial organization of collagen-fiber network. Among a number of candidate models, the four-fiber family (microstructure-motivated) model, especially that including dispersions of fiber angles about the main directions, was superior to the Fung- and Gasser-type models in the fitting quality allowed, though it presented a practical difficulty in parameter estimation, so that an analysis was conducted aiding the identification of a more specific diagonal- and circumferential-fiber family model for all three layers. The adventitia was stiffer and stronger than the other layers, owing to its increased collagen content, and its contribution to the response of the intact wall was augmented being under greater residual tension than the media, whereas the intima was under residual compression. All layers were stiffer circumferentially than longitudinally, due to preferential collagen arrangement along that axis. The histologically-guided material characterization of layered wall presented herein is expected to assist clinical decision, by developing reliable criteria to predict the rupture risk of abdominal aortic aneurysms, and optimize endovascular interventions. © 2015 Elsevier Ltd.},
 annote = {Export Date: 29 August 2026; Cited By: 50},
 author = {Sassani, S.G. and Kakisis, J. and Tsangaris, S. and Sokolis, D.P.},
 doi = {10.1016/j.jmbbm.2015.04.027},
 issn = {17516161 (ISSN)},
 journal = {Journal of the Mechanical Behavior of Biomedical Materials},
 keywords = {abdominal aorta, abdominal aorta aneurysm, Abdominal aortic aneurysm, Abdominal aortic aneurysms, adult, adventitia, aged, Aged, Aged, 80 and over, Aorta, Abdominal, Aortic Aneurysm, Abdominal, Article, biological model, Biomechanical Phenomena, biomechanics, Blood vessels, Characterization, clinical article, collagen, Collagen, collagen fiber, compression, Dispersions, Endovascular interventions, female, Female, Fibers, histopathology, human, human tissue, Humans, intima, Layered wall, longitudinal study, male, Male, Material characterizations, Mechanical Processes, mechanical stimulus test, mechanical stress, Mechanical testing, mechanics, metabolism, Microscopic evaluation, Microstructure, Microstructure-motivated modeling, middle aged, Middle Aged, Models, Cardiovascular, pathology, phenomenology, priority journal, Quality control, Quantitative histology, quantitative study, Residual compression, Spatial organization, Stress, Mechanical, Uniaxial tension, Uniaxial tensions, very elderly},
