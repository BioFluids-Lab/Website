@inproceedings{georgantopoulou_cartesian_2010,
 abstract = {This study examines the use of Cartesian grids with block refinement in space for steady flow computations around domains of irregular shape bounds, and especially around symmetric airfoils. In order to avoid the complexity of the body fitted numerical grid generation procedure, we use a saw tooth method for the curvilinear geometry approximation. The refinement method is based on the use of a sequence of nested rectangular meshes in which numerical simulation is taking place. The method is applied for laminar flows and based on a cell-centre approximation projection. We present the numerical simulation around a symmetric airfoil NACA0012. The utility of the algorithm is tested by comparing the convergence characteristics and accuracy to those of the standard single grid algorithm. The Cartesian block refinement algorithm can be used in complex curvilinear geometries and airfoils simulation, to accomplish a reduction in memory requirements and the computational time effort.},
 annote = {Export Date: 29 August 2026; Cited By: 3; Correspondence Address: C. G. Georgantopoulou; Department of Mechanical Engineering, National Technical University of Athens, Zografou-Athens, Heroon Polytechniou 9, Greece; email: chgg@hua.gr; Conference name: 4th International Conference on Applied Mathematics, Simulation, Modelling, ASM'10; Conference date: 22 July 2010 through 25 July 2010; Conference code: 85091},
 author = {Georgantopoulou, C.G. and Vasilikos, N.S. and Georgantopoulos, G.A. and Tsangaris, S.G.},
 booktitle = {Int. Conf. Appl. Math., Simul., Model.-Proc.},
 isbn = {17924332 (ISSN); 978-960474210-3 (ISBN)},
 keywords = {Airfoil simulation, Airfoils, Algorithms, Block nested refinement, Cartesian grid, Cartesian grids, Cartesians, Computational time, Computer simulation, Convergence characteristics, Convergence of numerical methods, Curvilinear geometry, Flow computation, Incompressible flows, Irregular shape, Laminar flow, Mathematical models, Memory requirements, Mesh generation, N-S equations, Navier Stokes equations, Numerical calculation, Numerical grid generation, Rectangular mesh, Refinement algorithms, Refinement grids, Refinement methods, Saw-tooth},
 language = {English},
