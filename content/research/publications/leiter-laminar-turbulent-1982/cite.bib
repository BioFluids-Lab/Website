@article{leiter_laminar-turbulent_1982,
 abstract = {In den letzten Jahren wurde eine Reihe von Untersuchungen mit der Heißfilmsonden-Anemo-metrie durchgeführt, nach denen auch im physiologischen Fall »turbulent bursts« in die Aortenströmung des Menschen eingebettet sind. In der vorliegenden Arbeit wurden an Hand einer geeigneten in-vitro-Anordnung die Bedingungen für den laminar-turbulenten Übergang untersucht. Demnach sind nicht so sehr die Strömungs-Störungen aus dem Herzen als vielmehr jene aus der Grenzschichtbildung dafür maßgeblich. © 1982, Walter de Gruyter. Alle Rechte vorbehalten.},
 annote = {Export Date: 29 August 2026; Cited By: 0},
 author = {Leiter, E. and Tsangaris, S.},
 doi = {10.1515/bmte.1982.27.10.228},
 issn = {00135585 (ISSN)},
 journal = {Biomedizinische Technik},
 keywords = {aorta, Aorta, Aortenströmung, Aortic Flow, article, blood flow velocity, Blood Flow Velocity, coronary artery blood flow, Coronary Circulation, English Abstract, Heißfilmsonden-Anemometrie, Hot film Anemometry, human, Human, Laminar-turbulent Transition, laminar-turbulenter, pathophysiology, turbulent bursts, Turbulent Bursts, Übergang},
 language = {German},
 number = {10},
 pages = {228--234},
 shorttitle = {Zum laminar-turbulenten Übergang von Geschwindigkeits-Pulsen},
 title = {On the laminar-turbulent transition of velocity pulses},
 url = {https://doi.org/10.1515/bmte.1982.27.10.228},
