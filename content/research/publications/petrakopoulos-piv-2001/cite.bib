@inproceedings{petrakopoulos_piv_2001,
 abstract = {The velocity field on a plane perpendicular as well as parallel to the orifice of a bileaflet artificial heart valve was studied. The particle image velocimetry (PIV) was used for the measurements of the velocity field. The velocity vectors were calculated by performing cross correlation between two images being apart a time interval of 10 msec. It was found that on the plane normal to the orifice, the velocities exhibited two peaks far from the center of the tube. whereas, on the plane parallel to orifice, there was a maximum at the center of the tube. The method found to work satisfactorily only during the opening and closing of the valve.},
 annote = {Export Date: 27 August 2026; Cited By: 0; Correspondence Address: D.S. Mathioulakis; Natl. Technical University of Athens, Dept. of Mechanical Engineering, Fluids Section, Zografos 15773, Athens, 7 Heroon Polytechniou st., Greece; email: mathew@fluid.mech.ntua.gr; Conference name: Particle Image Velocimetry; Conference date: 17 September 2001 through 19 September 2001; Conference code: 62329},
 author = {Petrakopoulos, K. and Kolyva, C. and Mathioulakis, D.S.},
 booktitle = {DLR Mitt.},
 isbn = {14348462 (ISSN)},
 keywords = {Artificial heart valves, Artificial organs, Correlation methods, Flow of fluids, Flow patterns, Flow rates, Heart valve prostheses, Hydraulics, Pistons, Pressure control, Velocity measurement},
 language = {English},
