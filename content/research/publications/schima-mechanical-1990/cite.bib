@article{schima_mechanical_1990,
 abstract = {In the last few years many attempts were made to line artificial vascular grafts with in vitro grown endothelial cell layers and thereby to minimize the risk of thromboembolism. However, adherence and resistance against shear stress forces were not tested under physiological pulsatile shear stress forces. In this paper, a mock-circulation apparatus is described, which simulates various forms of pulsatile shear stress, and which at the same time meets the requirements of cell cultivation. It can be sterilized and needs less than 700 ml of culture medium for priming. The generated flow profile can be adapted to a wide range of shear stress and also to different viscosities of used media. To take account of the different viscosities of culture medium and blood, a computerized calculation of the shear stress pattern was performed. Using the results of this computer model, the flow pattern was modified to obtain normal physiological shear stress when using culture medium. Results of pulse generation and simulation for the superficial femoral artery are presented. © 1990.},
 annote = {Export Date: 29 August 2026; Cited By: 9; CODEN: JBMCB},
 author = {Schima, H. and Tsangaris, S. and Zilla, P. and Kadletz, M. and Wolner, E.},
 doi = {10.1016/0021-9290(90)90031-W},
 issn = {00219290 (ISSN)},
 journal = {Journal of Biomechanics},
 keywords = {Arteries, artery, article, biocompatibility, Biological Materials, Biomaterials--Biocompatibility, Biomechanics, Femoral Artery, methodology, Models, Cardiovascular, Peripheral Artery Walls, prosthesis, Pulsatile Flow, Pulse Generation, Rheology, shear stress, Stress, Mechanical, Stresses--Shear, Support, Non-U.S. Gov't, Ultrasonography, Vascular Grafts, Viscosity},
 language = {English},
 number = {8},
 pages = {845--851},
 title = {Mechanical simulation of shear stress on the walls of peripheral arteries},
 url = {https://doi.org/10.1016/0021-9290(90)90031-W},
 volume = {23},
 year = {1990}
}
