@article{sun_aerodynamic_2019,
 abstract = {Using experimental (particle-image velocimetry and force measurement) and numerical tools [steady Reynolds-averaged Navier-Stokes (RANS) equations with the shear stress transport (SST) k-turbulence model], the overtaking maneuver between two identical vehicle models was examined. Considering the maneuver to be quasi-steady, one of the models (overtaken vehicle) was fixed while the other (overtaking vehicle) was set at various axial distances from the overtaken vehicle. The lateral clearance between the vehicles was constant and equal to 35% of the vehicles' width. Due to the existence of an overpressure region upstream of the front of the overtaking vehicle, a side force was applied on the overtaken vehicle. Moreover, due to low pressures in the space between the two vehicles, a reduction in the base pressure of the overtaken vehicle caused an increase in its drag. Both forces and the yaw moment varied significantly when the front of the overtaking vehicle moved from the rear of the overtaken toward its front. © 2019 American Society of Civil Engineers.},
 annote = {Export Date: 29 August 2026; Cited By: 13; Correspondence Address: D. Mathioulakis; China-EU Institute for Clean and Renewable Energy, Huazhong Univ. of Science and Technology, Wuhan, 1037 Luoyu Rd., 430074, China; email: mathew@fluid.mech.ntua.gr; CODEN: JLEED},
 author = {Sun, H. and Karadimitriou, E. and Li, X.M. and Mathioulakis, D.},
 doi = {10.1061/(ASCE)EY.1943-7897.0000601},
 issn = {07339402 (ISSN)},
 journal = {Journal of Energy Engineering},
 keywords = {Aerodynamic interference, Bluff body, Drag, Navier Stokes equations, Particle image velocimetries, Pressure, Reynolds averaged Navier Stokes (RANS)equations, Reynolds-Averaged Navier-Stokes, Reynolds-averaged Navier-Stokes (RANS), Shear stress, Shear-stress transport, Side force, Turbulence modeling, Turbulence models, Vehicles, Velocity measurement, Yaw moment},
 language = {English},
 number = {2},
 publisher = {American Society of Civil Engineers (ASCE)},
 title = {Aerodynamic interference between two road vehicle models during overtaking},
 url = {https://doi.org/10.1061/(ASCE)EY.1943-7897.0000601},
 volume = {145},
 year = {2019}
}
