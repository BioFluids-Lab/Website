@article{tsangaris_couette_2007,
 abstract = {In the present paper the flow of a Bingham fluid between two parallel porous walls is studied. One of the walls moves with constant velocity parallel to the other, which is fixed, while a longitudinal pressure gradient exists, as well as a transverse flow field due the porosity of the walls. An exact analytical solution is given for the u-velocity field, which has four different forms depending on the values of the three dimensionless parameters, which are the Bingham, Couette and Reynolds numbers. © 2007 Elsevier B.V. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 15; Correspondence Address: S. Tsangaris; School of Mechanical Engineering, Fluids Section, National Technical University of Athens, Zografou, 15773 Athens, Greece; email: sgt@fluid.mech.ntua.gr; CODEN: JNFMD},
 author = {Tsangaris, S. and Nikas, C. and Tsangaris, G. and Neofytou, P.},
 doi = {10.1016/j.jnnfm.2007.03.004},
 issn = {03770257 (ISSN)},
 journal = {Journal of Non-Newtonian Fluid Mechanics},
 keywords = {Analytical solution, Bingham plastic, CFD, Channel flow, Computational fluid dynamics, Computer simulation, Couette flow, Flow velocity, Plastic flow, Porous boundary, Pressure gradient, Reynolds number, Wall flow},
 language = {English},
 number = {1},
 pages = {42--48},
 title = {Couette flow of a Bingham plastic in a channel with equally porous parallel walls},
 url = {https://doi.org/10.1016/j.jnnfm.2007.03.004},
 volume = {144},
 year = {2007}
}
