@article{thomadakis_improved_1992,
 abstract = {The influence of artificial dissipation schemes on the accuracy and stability of the numerical solution of compressible flow is extensively examined. Using an implicit central difference factored scheme, an improved form of artificial dissipation is introduced which highly reduces the errors due to numerical viscosity. A function of the local Mach number is used to scale the amount of numerical damping added into the solution according to the character of the flow in several flow regimes. The resulting scheme is validated through several inviscid flow test cases. Copyright © 1992 John Wiley & Sons, Ltd},
 annote = {Export Date: 29 August 2026; Cited By: 3},
 author = {Thomadakis, M.P. and Tsangaris, S.},
 doi = {10.1002/fld.1650141203},
 issn = {02712091 (ISSN)},
 journal = {International Journal for Numerical Methods in Fluids},
 keywords = {Artificial dissipation schemes, Artificial Dissipation Schemes, Central difference schemes, Compressible flow, Compressible Flow, Euler equations, Euler Equations, Implicit Central Difference Factored Scheme, Local Mach Number Function, Mathematical Models, Numerical Damping, Numerical Methods, Numerical Viscosity},
 language = {English},
 number = {12},
 pages = {1391--1405},
 title = {Improved artificial dissipation schemes for the Euler equations},
 url = {https://doi.org/10.1002/fld.1650141203},
 volume = {14},
 year = {1992}
}
