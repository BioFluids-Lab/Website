@article{marinakis_new_1999,
 abstract = {A new capillary system was developed, incorporating infrared sensors, which allowed the determination of whole blood viscosity over a wide range of shear stresses. Flow conditions were defined by the geometry of the capillary and the sample pressure head. Whole blood was considered to be a power law fluid and a modified Mooney's formula was used for the calculation of the related invariants. The new viscometer proved to be very simple in use, requiring one run, had a short measuring time and utilised a small test sample volume. However it can be used for whole blood viscosity measurements only at medium and high shear stresses.},
 annote = {Export Date: 29 August 2026; Cited By: 5; Correspondence Address: G.N. Marinakis; Fluids Section, Department of Mechanical Engineering, Natl. Technical University of Athens, 157 10 Zografos, Athens, P.O. Box 64070, Greece; email: eiaa@otenet.gr; CODEN: BRHLA},
 author = {Marinakis, G.N. and Barbenel, J.C. and Fisher, A.C. and Tsangaris, S.G.},
 doi = {10.1177/0006355X1999036004004},
 issn = {0006355X (ISSN)},
 journal = {Biorheology},
 keywords = {article, blood viscosity, Blood Viscosity, calculation, capillary, Capillary, Evaluation Studies, Hematologic Tests, Humans, infrared radiation, Power law, sensor, shear stress, Stress, Mechanical, Time Factors, viscometer, Viscometer, viscometry, Viscosity, Whole blood},
 language = {English},
 number = {4},
 pages = {311--318},
 title = {A new capillary viscometer for whole blood viscosimetry},
 url = {https://doi.org/10.1177/0006355X1999036004004},
 volume = {36},
 year = {1999}
}
