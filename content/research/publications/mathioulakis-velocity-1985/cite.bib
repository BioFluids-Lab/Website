@article{mathioulakis_velocity_1985,
 abstract = {Steady and unsteady velocity components over a backward facing circular arc are measured by a 2 component laser Doppler velocimetry. A periodic disturbance is added to the mean flow and the response of unsteady separation is investigated. Based on the measured quantities, the instantaneous values of the terms of the Navier Stokes equations are calculated. Special attention is given to the distribution and the flux of vorticity. (A)},
 annote = {Export Date: 29 August 2026; Cited By: 0},
 author = {Mathioulakis, D.S. and Telionis, D.P.},
 language = {English},
 publisher = {Calif. State Univ},
 title = {Velocity and vorticity measurements around laminar separation in periodic flow},
 url = {https://ui.adsabs.harvard.edu/abs/1985snpa.proc....7M/abstract},
 year = {1985}
}
