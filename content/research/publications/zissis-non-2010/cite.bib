@inproceedings{zissis_non_2010,
 abstract = {The flow behavior of four non newtonian shear thinning fluids, namely Walburn-Schneck, Herschel-Bulkley, Quemada and Casson were studied numerically in a straight circular tube as well as in a 75% axisymmetric stenosis under steady and unsteady inlet flow conditions. Reynolds varied from 25 to 150, Strouhal from 0.05 to 1 and Womersley number from 2.8 to 12.53. Comparisons were performed between the models and the Newtonian one. In steady flow cases, the non Newtonian behaviour becomes evident with reducing Re whereas in unsteady cases, the flow patterns are dependent on Re, Str and the fluid model. © 2010 IEEE.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: D. S. Mathioulakis; Fluid Mechanics Section, School of Mechanical Engineering, National Technical University, Athens, Greece; email: mathew@fluid.mech.ntua.gr; Conference name: 10th International Conference on Information Technology and Applications in Biomedicine: Emerging Technologies for Patient Specific Healthcare, ITAB 2010; Conference date: 2 November 2010 through 5 November 2010; Conference code: 83786},
 author = {Zissis, J.A. and Mathioulakis, D.S.},
 booktitle = {Proc IEEE EMBS Reg 8 Int Conf Inf Technol Appl Biomed ITAB},
 doi = {10.1109/ITAB.2010.5687665},
 isbn = {978-142446560-6 (ISBN)},
 keywords = {Axisymmetric, Circular tubes, Flow behaviors, Flow condition, Fluid models, Herschel-Bulkley, Information technology, Inlet flow, Newtonians, Non Newtonian flow, Non-newtonian, Reynolds, Shear flow, Shear thinning fluids, Womersley numbers},
 language = {English},
 note = {Journal Abbreviation: Proc IEEE EMBS Reg 8 Int Conf Inf Technol Appl Biomed ITAB},
 title = {Non Newtonian flow study in an axisymmetric tube stenosis},
 url = {https://doi.org/10.1109/ITAB.2010.5687665},
 year = {2010}
}
