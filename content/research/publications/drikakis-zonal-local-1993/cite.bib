@article{drikakis_zonal-local_1993,
 abstract = {Azonal-local solution method is developed for the solution of the compressible Navier-Stokes equations. The main feature of the method is coupling of the Navier- Stokes equations with the Euler equations and the local mesh solution procedure. Mesh sequencing (multilevel) technique is also used for the improvement of the efficiency of the algorithm. The methodology is applied to turbulent flowfields past an airfoil. A flux vector splitting method with an upwind scheme up to fourth-order accuracy is used for the discretization of the inviscid fluxes. The system of the equations is solved by an unfactored implicit method using Gauss-Seidel relaxation. © 1993 American Institute of Aeronautics and Astronautics, Inc., All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 2},
 author = {Drikakis, D. and Tsangaris, S.},
 doi = {10.2514/3.11846},
 issn = {00011452 (ISSN)},
 journal = {AIAA Journal},
 keywords = {Airfoils, Algorithms, Computational methods, Euler equations, Fluid dynamics, Flux vector splitting method, Gauss-Siedel relaxation, Implicit methods, Interpolation, Iterative methods, Navier-Stokes equations, Relaxation processes, Turbulent flow, Vectors, Zonal local solution method},
 language = {English},
 number = {10},
 pages = {1759--1760},
 title = {Zonal-local solution method for the turbulent Navier-Stokes equations},
 url = {https://doi.org/10.2514/3.11846},
 volume = {31},
 year = {1993}
}
