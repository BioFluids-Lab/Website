 annote = {Export Date: 29 August 2026; Cited By: 0},
 author = {Telionis, D.P. and Mathioulakis, D.},
 keywords = {Flow measurement, Separation},
 language = {English},
 publisher = {Virginia Polytech. Inst. & State Univ},
 title = {Shedding of vorticity at separation},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85040872971&partnerID=40&md5=fe34aa9f314e98071527f53743171f4d},
 year = {1984}
}
