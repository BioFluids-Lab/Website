@article{papaioannou_simulation_2003,
 abstract = {Arterial compliance (AC) is expected to play a major role on cardiac efficacy by acute or long-term mechanisms. The aim of this study was to investigate the purely mechanical effect of AC on left ventricular (LV) performance, for different conditions of LV dysfunction (systolic versus diastolic). A hydraulic, Windkessel model of systemic circulation was used. LV function and aortic flow were simulated using a left ventricular assist device (LVAD). Two cases of LV dysfunction were simulated: Case A, systolic and Case B, diastolic dysfunction. In Case A, AC increased from 1.14 to 2.85 ml mm Hg-1 leading to an increase in LVAD stroke volume up to 6%, while no significant effect was observed in Case B. LVAD systolic work was decreased by 4% in systolic and by 11% in diastolic LVAD dysfunction. The purely mechanical effect of AC changes on LVAD function was different between systolic and diastolic dysfunction. It might be expected that even an acute reduction in arterial stiffness could enhance LV performance by different means in systolic compared to diastolic dysfunction.},
 annote = {Export Date: 29 August 2026; Cited By: 19; Correspondence Address: T.G. Papaioannou; Ano Kipseli, 113 63, Athens, Iak. Patatsou 13, Greece; email: theopap@central.ntua.gr; CODEN: JMTED},
 author = {Papaioannou, T.G. and Mathioulakis, D.S. and Tsangaris, S.G.},
 doi = {10.1080/0309190021000043701},
 issn = {03091902 (ISSN)},
 journal = {Journal of Medical Engineering and Technology},
 keywords = {Arteries, artery compliance, article, Blood Flow Velocity, Blood Pressure, blood pressure measurement, Cardiology, Compliance, Computer simulation, diastole, Diastole, diastolic blood pressure, Flow of fluids, flow rate, heart assist device, heart left ventricle function, heart rate, Humans, Models, Cardiovascular, pulse pressure, Stiffness, systole, Systole, systolic blood pressure, Ventricular dysfunction, Ventricular Dysfunction, Left},
 language = {English},
 number = {2},
 pages = {85--89},
 title = {Simulation of systolic and diastolic left ventricular dysfunction in a mock circulation: the effect of arterial compliance},
 url = {https://doi.org/10.1080/0309190021000043701},
 volume = {27},
 year = {2003}
}
