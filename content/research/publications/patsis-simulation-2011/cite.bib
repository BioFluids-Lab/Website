@inproceedings{patsis_simulation_2011,
 abstract = {Continuum hydrodynamics accurately describes the flow of fluids over a wide range of systems. However, continuum models are unable to adequately describe the flow of fluid under extreme confinement. In particular, the no-slip boundary condition invoked in continuum flow calculations is violated for low density gases flowing in microtubes or nanoporous materials. The calculation of gas mass transfer rate in microtubes using experiments and simulation is investigated in the case of small absolute pressures. Specifically, in the present work, Argon gas is considered in a 3D model of two metallic tanks connected through microchannels. The pressure difference between the inlet and the outlet of the structure is monitored as a function of time. Thus the gas transfer rate is evaluated and compared with experimental data, in order to verify the departure from the standard Navier - Stokes equations with the no-slip boundary condition.},
 annote = {Export Date: 27 August 2026; Cited By: 1; Correspondence Address: G.P. Patsis; Department of Electronics, TEI of Athens, Athens, Greece; email: patsisg@teiath.gr; Conference name: 25th Eurosensors Conference; Conference date: 4 September 2011 through 7 September 2011; Conference code: 88600},
 author = {Patsis, G.P. and Ninos, K. and Mathioulakis, D. and Kaltsas, G.},
 booktitle = {Procedia Eng.},
 doi = {10.1016/j.proeng.2011.12.111},
 isbn = {18777058 (ISSN)},
 keywords = {3D models, Absolute pressure, Argon, Argon gas, COMSOL, Continuum flow, Continuum hydrodynamics, Continuum mechanics, Continuum model, Experimental data, Experimental evaluation, Function of time, Gas mass, Gas mass flow, Gas transfer, Gases, Mass transfer, Mass transfer rate, Micro-tubes, Microchannels, Microfluidics, Nanoporous Materials, Navier Stokes equations, No-slip boundary conditions, Porous materials, Pressure differences, Rarefied gas, Simulation, Stokes equations, Three dimensional},
 language = {English},
 note = {Journal Abbreviation: Procedia Eng.},
 pages = {447--450},
 title = {Simulation and experimental evaluation of gas mass flow transfer rate in microchannels},
 url = {https://doi.org/10.1016/j.proeng.2011.12.111},
 volume = {25},
 year = {2011}
}
