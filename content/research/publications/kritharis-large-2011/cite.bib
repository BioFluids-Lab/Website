@inproceedings{kritharis_large_2011,
 abstract = {The present study set out to examine alterations in the biomechanical characteristics of large-artery wall in response to moderate blood flow increase, as such information is scarce in the literature. For this purpose, a shunt was created between the right carotid artery and ipsilateral jugular vein in a porcine animal model, as a result of which pressure remained unchanged but flow doubled at the proximal arterial segment until animal sacrifice one month later. The shunted and contralateral arterial (proximal) segments were excised for morphological observation, i.e. delineation of the stress-free geometry, and triaxial mechanical testing, i.e. pressurization and longitudinal extension. Blood flow elevation was accompanied by significant lumen enlargement and wall thickening at in-vivo conditions, allowing restoration of shear and intramural-stresses to homeostatic values within one month. The diameter range and shape of the diameter-pressure curves of shunted arteries was also modified, indicating alterations in elastic properties. At mean working pressures, compliance increased and elastic modulus decreased in shunted than contralateral arteries. Our data imply that the arterial morphology under sustained flow-overload adapts within the one-month period of our study, in order to normalize intimal shear and intramural stresses, but this is not the case with the biomechanical characteristics. © 2011 IEEE.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Correspondence Address: D.P. Sokolis; Laboratory of Biomechanics, Center for Experimental Surgery, Academy of Athens, Athens, Greece; email: DimitrisSokolis@ath.forthnet.gr; Conference name: 10th IEEE International Workshop on Biomedical Engineering, BioEng 2011; Conference date: 5 October 2011 through 7 October 2011; Conference code: 87603},
 author = {Kritharis, E.P. and Kakisis, J.D. and Stergiopulos, N. and Tsangaris, S. and Sokolis, D.P.},
 booktitle = {IEEE Int. Workshop Biomed. Eng., BioEng},
 doi = {10.1109/IWBE.2011.6079017},
 isbn = {978-145770552-6 (ISBN)},
 keywords = {Animal model, Animal sacrifice, Animals, Biomechanical characteristics, Biomechanics, Biomedical engineering, Blood, Blood flow, Carotid artery, Elastic properties, Hemodynamics, In-vivo, Jugular veins, Longitudinal extension, Mechanical testing, Morphological observations, Shear flow, Stresses, Wall thickening, Working pressures},
 language = {English},
 note = {Journal Abbreviation: IEEE Int. Workshop Biomed. Eng., BioEng},
 title = {Large artery biomechanical adaptation induced by flow-overload},
 url = {https://doi.org/10.1109/IWBE.2011.6079017},
 year = {2011}
}
