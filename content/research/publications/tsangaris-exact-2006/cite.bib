@article{tsangaris_exact_2006,
 abstract = {Analytical solutions of the equations of motion of a Newtonian fluid for the fully developed laminar flow between two concentric cylinders are presented, when an oscillating circumferential pressure gradient is imposed (finite gap oscillating Dean flow). The walls of the cylinders are porous, so that a radial flow can be superimposed. The analytical solution is examined for a variety of values of the dimensionless parameters, which are the transverse radial Reynolds number, the Womersley number and the ratio of the radii of the cylinders. © 2006 Elsevier Ltd. All rights reserved.},
 annote = {Export Date: 29 August 2026; Cited By: 28; Correspondence Address: S. Tsangaris; National Technical University of Athens, School of Mechanical Engineering, Fluids Section, 15773 Zografou, Athens, Heroon Polytechniou 9, Greece; email: sgt@fluid.mech.ntua.gr; CODEN: IJESA},
 author = {Tsangaris, S. and Kondaxakis, D. and Vlachakis, N.W.},
 doi = {10.1016/j.ijengsci.2006.08.010},
 issn = {00207225 (ISSN)},
 journal = {International Journal of Engineering Science},
 keywords = {Circumferential pressure, Dean flow, Equations of motion, Laminar flow, Navier Stokes equations, Oscillating flow, Oscillations, Porous materials, Porous walls, Pulsatile flow, Reynolds number},
 language = {English},
 number = {20},
 pages = {1498--1509},
 title = {Exact solution of the Navier-Stokes equations for the pulsating Dean flow in a channel with porous walls},
 url = {https://doi.org/10.1016/j.ijengsci.2006.08.010},
 volume = {44},
 year = {2006}
}
