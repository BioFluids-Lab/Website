@article{neofytou_vascular_2008,
 abstract = {The current study is focused on the numerical investigation of the flow field induced by the unsteady flow in the vicinity of an abdominal aortic aneurysm model. The computational fluid dynamics code used is based on the finite volume method, and it has already been used in various bioflow studies. For modelling the rheological behaviour of blood, the Quemada non-Newtonian model is employed, which is suitable for simulating the two-phase character of blood namely a suspension of blood cells in plasma. For examining its non-Newtonian effects a comparison with a corresponding Newtonian flow is carried out. Furthermore, the investigation is focused on the distribution of the flow-induced forces on the interior wall of the aneurysm and in order to study the development of the distribution with the gradual enlargement of the aneurysm, three different degrees of aneurysm-growth have been assumed. Finally and for examining the effect of the distribution on the aneurysm growth, a comparison is made between the pressure and wall shear-stress distributions at the wall for each growth-degree. © 2009 Informa plc.},
 annote = {Export Date: 29 August 2026; Cited By: 15},
 author = {Neofytou, P. and Tsangaris, S. and Kyriakidis, M.},
 doi = {10.1080/10255840802214999},
 issn = {14768259 (ISSN)},
 journal = {Computer Methods in Biomechanics and Biomedical Engineering},
 keywords = {aneurysm, Aneurysm, animal, Animals, Arteries, artery, article, biological model, blood flow velocity, Blood Flow Velocity, blood pressure, Blood Pressure, Computational fluid dynamics, computer simulation, Computer Simulation, Elastic Modulus, human, Humans, mechanical stress, Models, Cardiovascular, pathophysiology, pulsatile flow, Pulsatile Flow, Pulsating flow, shear strength, Shear Strength, Stress, Mechanical, young modulus},
 language = {English},
 number = {6},
 pages = {615--626},
 title = {Vascular wall flow-induced forces in a progressively enlarged aneurysm model},
 url = {https://doi.org/10.1080/10255840802214999},
 volume = {11},
 year = {2008}
}
