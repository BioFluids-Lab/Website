@article{tsangaris_exact_2003-1,
 abstract = {The Navier-Stokes equations have been solved in order to obtain an analytical solution of the fully developed laminar flow in a duct having a rectangular cross section with two opposite equally porous walls. We obtained solutions both for the case of steady flow as well as for the case of oscillating pressure gradient flow. The pulsating flow is obtained by the superposition of the steady and oscillating pressure gradient solutions. The solution has applications for blood flow in fiber membranes used for the artificial kidney.},
 annote = {Export Date: 29 August 2026; Cited By: 25; Correspondence Address: S. Tsangaris; Department of Mechanical Engineering, Natl. Technical University of Athens, Fluids Section, 15710 Zografou, Athens, Greece; email: sgt@fluid.mech.ntua.gr; CODEN: JFEGA},
 author = {Tsangaris, S. and Vlachakis, N.W.},
 doi = {10.1115/1.1537250},
 issn = {00982202 (ISSN)},
 journal = {Journal of Fluids Engineering, Transactions of the ASME},
 keywords = {Boundary conditions, Incompressible flow, Laminar flow, Navier Stokes equations, Partial differential equations, Pressure effects, Pressure gradient, Pulsatile flow, Reynolds number},
 language = {English},
 number = {2},
 pages = {382--384},
 title = {Exact solution of the Navier-Stokes equations for the fully developed, pulsating flow in a rectangular duct with a constant cross-sectional velocity},
 url = {https://doi.org/10.1115/1.1537250},
 volume = {125},
 year = {2003}
}
