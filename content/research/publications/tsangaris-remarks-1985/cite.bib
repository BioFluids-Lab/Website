@article{tsangaris_remarks_1985,
 abstract = {Some interesting aspects of the viscous flow due to an oscillating pressure gradient along a straight, circular pipe with rigid walls are discussed. The oscillating velocity amplitude and phase difference angle obtained in analytical closed forms have the known boundary layer characteristics. The phase difference angle between velocity and pressure gradient involves a discontinuity at the wall for large values of the dimensionless frequency and it can be greater than - 90 degree as well as smaller.},
 annote = {Export Date: 29 August 2026; Cited By: 0; CODEN: RTMAA},
 author = {Tsangaris, S.},
 issn = {00354074 (ISSN)},
 journal = {Revue roumaine des sciences techniques. Serie de mecanique appliquee},
 keywords = {FLOW OF FLUIDS, FLUID DYNAMICS, OSCILLATORY VISCOUS FLOW},
 language = {English},
 number = {4},
 pages = {365--369},
 title = {Some remarks on the oscillatory pipe flow},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0022101538&partnerID=40&md5=c0d1cd7178aca9aaafb660e4ff29aa1b},
