@inproceedings{drikakis_determination_1992,
 abstract = {In the present paper the determination of an inviscid ideal non-dissociated gas flow into an axisymmetric convergent-divergent nozzle is obtained using high order of accuracy methods, greater than the second order of accuracy, for the discretization of the compressible Euler equations. Three different methods are used. The spatial accuracy of the methods is up to fourth order while comparison with second order of accuracy solution is presented. A modern implicit Newton-type method leads to fast convergence to steady state solution. Comparison of the computational results with the corresponding experimental data, confirm the reliability of the present methods.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Conference name: ECOS '92 International Symposium on Efficiency, Cost, Optimization and Simulation; Conference date: 15 June 1992 through 18 June 1992; Conference code: 17553},
 author = {Drikakis, D. and Tsangaris, S.},
 booktitle = {ECOS 92 Int Symp Effic Cost Opt Simul},
 isbn = {0791806316 (ISBN)},
 keywords = {Axisymmetric convergent divergent nozzles, Compressible Euler equations, Convergence of numerical methods, Gas dynamics, Implicit Newton type method, Inviscid ideal nondissociated gas flow, Mathematical models, Nozzles, Numerical methods, Spatial accuracy},
 language = {English},
 note = {Journal Abbreviation: ECOS 92 Int Symp Effic Cost Opt Simul},
 pages = {491--499},
 publisher = {Publ by ASME},
 title = {Determination of internal gas flow by higher order methods},
 url = {https://www.scopus.com/pages/publications/0026971539},
 year = {1992}
}
