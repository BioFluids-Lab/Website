@article{papaioannou_experimental_2005,
 abstract = {1. Pulse pressure (PP) constitutes an independent predictor of cardiovascular events and mortality in various populations. Heart rate (HR) and arterial stiffness, in addition to their independent predictive value for cardiovascular complications, seem to interact with regard to the modification of PP. The aim of the present study was to investigate the association of PP with HR under different levels of arterial compliance (AC), revealing their synergistic effects. 2. Seventy-one normotensive and untreated hypertensive subjects were examined. Arterial compliance was measured by the 'area' method, whereas central blood pressures and wave reflections were evaluated using the Sphygmocor® system (AtCor Medical, Sydney, NSW, Australia). A hydraulic Windkessel model was also used to evaluate the independent effect of HR and AC on PP. Peripheral PP was associated only with mean pressure and AC. In contrast, central PP was further related to HR (20 b.p.m. decrease in HR resulted in central PP augmentation by 5.6 mmHg) regardless of mean pressure, stroke volume, age and gender. However, this association was statistically significant only for subjects with lower AC (\textless 1.1 mL/mmHg) and not for those with more compliant arteries. These findings are also in accordance with the experimental data. 3. Aortic PP is affected to a greater degree by HR changes compared with peripheral PP. This response was observed only at high levels of arterial stiffness. 4. The present study provides the first evidence regarding the combined effect of AC and HR on aortic PP, which may lead to larger clinical or epidemiological studies aiming to optimization of drug treatment and to a possible reduction of cardiovascular risk.},
 annote = {Export Date: 29 August 2026; Cited By: 16; Correspondence Address: T.G. Papaioannou; Nea Kipseli, Athens 113 63, Iak Patatsou 13, Greece; email: theopap@mail.ntua.gr; CODEN: CEXPB},
 author = {Papaioannou, T.G. and Protogerou, A. and Papamichael, C. and Mathioulakis, D. and Tsangaris, S. and Karatzis, E. and Toumanidis, S. and Zakopoulos, N. and Lekakis, J.},
 doi = {10.1111/j.1440-1681.2005.04174.x},
 issn = {03051870 (ISSN)},
 journal = {Clinical and Experimental Pharmacology and Physiology},
 keywords = {adult, age, aged, Arterial stiffness, Arteries, artery compliance, article, Biomechanics, Blood Pressure, blood pressure measurement, cardiovascular disease, cardiovascular risk, Central aortic pressures, clinical article, Compliance, controlled study, device, Experimental model, female, Female, gender, heart rate, Heart rate, Heart Rate, heart stroke volume, human, Humans, hypertension, Hypertension, male, Male, mean arterial pressure, Middle Aged, Mock circulation, Models, Cardiovascular, mortality, pulse pressure, Pulse pressure, Pulse pressure amplification, rigidity, risk reduction, Wave reflections},
 language = {English},
 number = {3},
 pages = {210--217},
 title = {Experimental and clinical study of the combined effect of arterial stiffness and heart rate on pulse pressure: differences between central and peripheral arteries},
 url = {https://doi.org/10.1111/j.1440-1681.2005.04174.x},
