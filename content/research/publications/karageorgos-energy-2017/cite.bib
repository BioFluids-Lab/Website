@inproceedings{karageorgos_energy_2017,
 abstract = {In this paper, we present an optimized design of an energy harvesting device that converts the arterial wall pulsation to electrical energy and we demonstrate its feasibility to function as a sensor for cardiovascular system monitoring. The device is based on electromagnetic induction and is composed of a coil that pulsates with the artery inside the magnetic field produced by two permanent magnets. In order to validate the proposed concept and evaluate the device's performance, an experimental setup that mimics blood flow and arterial wall movement was constructed. In-vitro experiments indicated that proper optimization can increase the device's produced power and voltage, and that the output voltage of the coil is associated with heart rate, blood pressure, arterial wall velocity and deformation. © 2017 Euraap.},
 annote = {Export Date: 29 August 2026; Cited By: 0; Conference name: 11th European Conference on Antennas and Propagation, EUCAP 2017; Conference date: 19 March 2017 through 24 March 2017; Conference code: 127824},
 author = {Karageorgos, G. and Manopoulos, C. and Tsangaris, S. and Nikita, K.S.},
 booktitle = {Euro. Conf. Antenn. Propag., EUCAP},
 doi = {10.23919/EuCAP.2017.7928637},
 isbn = {978-889070187-0 (ISBN)},
 keywords = {Arterial wall, Arterial wall movements, arterial wall pulsation, blood pressure, Blood pressure, cardiovascular monitoring, Cardiovascular monitoring, Cardiovascular system, Electrical energy, Electromagnetic induction, energy harvesting, Energy harvesting, Energy harvesting device, Optimized designs, Output voltages, Self-powered, self-powered sensor},
 language = {English},
 note = {Journal Abbreviation: Euro. Conf. Antenn. Propag., EUCAP},
 pages = {2491--2494},
 publisher = {Institute of Electrical and Electronics Engineers Inc.},
 title = {Energy harvesting and cardiovascular monitoring through arterial wall pulsation},
 url = {https://doi.org/10.23919/EuCAP.2017.7928637},
 year = {2017}
}
